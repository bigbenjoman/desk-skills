#!/usr/bin/env bash
# desk-q: every autopilot queue on this computer, from one terminal. Reads only.
# The logic is desk-q.mjs among the desk scripts install.sh puts in ~/.claude/desk/bin.
#   desk-q [--plain] [--all]  ·  desk-q [--plain] <repo>  ·  desk-q [--plain] <repo> show <KEY>
exec node "$HOME/.claude/desk/bin/desk-q.mjs" "$@"
