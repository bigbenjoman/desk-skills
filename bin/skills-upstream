#!/usr/bin/env python3
"""Check and upgrade the third-party skills pinned in desk-skills' vendor/ (brew-style).

  skills-upstream list                 every pinned skill, its source and pin
  skills-upstream outdated [--json]    compare each pin with its source; exit 10 if any is outdated
  skills-upstream upgrade <name>...    pull the newest upstream into vendor/<name> and update the pin
  skills-upstream upgrade --all        ...for every outdated skill
  skills-upstream verify               vendor/ matches sources.json, ~/.agents/skills matches vendor/, and links
  skills-upstream links                every skill install.sh installs is reachable as ~/.claude/skills/<name>
                                       and lands on the installed copy;
                                       exit 1 if any is not, with the one-line fix for each
  skills-upstream plugins [--json]     installed Claude Code plugins vs the version their marketplace pins
                                       (run `claude plugin marketplace update` first); exit 10 if any is behind
  skills-upstream is-clone-of <dir> <owner/repo>
                                       exit 0 if <dir> is a git clone whose origin IS github.com/<owner/repo>,
                                       1 if not; install.sh uses it, so both agree
  skills-upstream rehash               record each vendor/<name> tree hash in sources.json (after a hand edit)
  skills-upstream index                write ~/.agents/skills/skill-index (linked into ~/.claude/skills): a short
                                       map of areas plus areas/<area>.md with every visible skill's full
                                       description, sorted by desk/skill-areas.json
  skills-upstream index --name-only [--check] [--settings <file>]
                                       ...then list every indexed personal and claude.ai skill to Claude
                                       by name only (skillOverrides), leaving any entry already set alone;
                                       --check only reports (exit 1 if any is missing)

Sources (vendor/sources.json):
  github  {repo, path}                 newest commit touching <path> vs pin.commit (via `gh`)
  drive   {folder_id, file_name, ...}  the public folder's file list vs pin.drive_modified and file name;
                                       a changed zip is downloaded and its sha256 compared with the pin
  checkout {repo, branch}              your own skills: ~/.agents/skills/<name> IS a git clone of the repo
                                       (no copy in vendor/); outdated = commits on origin/<branch> not yet
                                       pulled; upgrade = `git pull --ff-only` after showing them

`upgrade` only changes files inside vendor/ (review them with `git diff`); installing them is
install.sh's job. Nothing here touches ~/.claude or ~/.agents except `verify` and `links`, which only
read, and `index`, which writes only the skill-index skill and its link (and, with --name-only,
skillOverrides in settings.json, which install.sh asks before running).
Last successful `outdated` run is stamped in ~/.claude/desk/skills-upstream.last.
"""

import hashlib
import html
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
import zipfile

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
VENDOR = os.path.join(ROOT, "vendor")
SOURCES = os.path.join(VENDOR, "sources.json")
INSTALLED = os.path.expanduser("~/.agents/skills")
CLAUDE_SKILLS = os.path.expanduser("~/.claude/skills")
STAMP = os.path.expanduser("~/.claude/desk/skills-upstream.last")
UA = {"User-Agent": "Mozilla/5.0 (desk-skills skills-upstream)"}


def die(msg, code=2):
    print(f"skills-upstream: {msg}", file=sys.stderr)
    sys.exit(code)


def load():
    with open(SOURCES) as f:
        return json.load(f)


def save(data):
    tmp = SOURCES + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, SOURCES)


RUNTIME_MARKERS = {".DS_Store", ".in_use", ".orphaned_at"}   # written by macOS / Claude Code, not content


def tree_files(path):
    out = {}
    for dirpath, dirs, files in os.walk(path):
        dirs[:] = [d for d in dirs if d not in ("__pycache__", "node_modules", ".git") and d not in RUNTIME_MARKERS]
        for name in files:
            if name in RUNTIME_MARKERS or name.endswith(".pyc"):
                continue
            full = os.path.join(dirpath, name)
            with open(full, "rb") as f:
                out[os.path.relpath(full, path)] = hashlib.sha256(f.read()).hexdigest()
    return out


def tree_changes(new, old):
    """Relative paths that differ between two folders, marked +added, -removed or ~changed."""
    a, b = tree_files(new), tree_files(old)
    return ([f"+{p}" for p in sorted(a.keys() - b.keys())] + [f"-{p}" for p in sorted(b.keys() - a.keys())]
            + [f"~{p}" for p in sorted(a.keys() & b.keys()) if a[p] != b[p]])


def tree_sha256(path):
    """Hash of a skill folder: sorted relative paths plus contents; runtime markers and bytecode ignored."""
    h = hashlib.sha256()
    for dirpath, dirs, files in os.walk(path):
        dirs[:] = sorted(d for d in dirs if d not in ("__pycache__", "node_modules") and d not in RUNTIME_MARKERS and d != ".git")
        for name in sorted(files):
            if name in RUNTIME_MARKERS or name.endswith(".pyc"):
                continue
            full = os.path.join(dirpath, name)
            h.update(os.path.relpath(full, path).encode() + b"\0")
            with open(full, "rb") as f:
                h.update(f.read())
            h.update(b"\0")
    return h.hexdigest()


def http(url, timeout=60):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def gh(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:300])
    return r.stdout


# ---- github ------------------------------------------------------------------------------------
def github_latest(src):
    out = gh("api", f"repos/{src['repo']}/commits?path={src['path']}&per_page=1",
             "--jq", ".[0] | [.sha, .commit.author.date[0:10], (.commit.message | split(\"\\n\")[0])] | @tsv")
    sha, date, msg = out.strip().split("\t", 2)
    return {"commit": sha[:9], "date": date, "message": msg}


def github_count_since(src, pin_commit):
    out = gh("api", f"repos/{src['repo']}/commits?path={src['path']}&per_page=100", "--jq", ".[].sha")
    shas = out.split()
    for i, s in enumerate(shas):
        if s.startswith(pin_commit):
            return i
    return None  # pin not in the last 100 commits of this path


def github_fetch(src, commit, dest):
    """Copy every file under src.path at commit into dest."""
    tree = json.loads(gh("api", f"repos/{src['repo']}/git/trees/{commit}?recursive=1"))
    prefix = src["path"].rstrip("/") + "/"
    files = [t["path"] for t in tree["tree"] if t["type"] == "blob" and t["path"].startswith(prefix)]
    if not files:
        raise RuntimeError(f"nothing under {src['path']} at {commit}")
    for p in files:
        raw = gh("api", f"repos/{src['repo']}/contents/{p}?ref={commit}", "--jq", ".content")
        import base64
        data = base64.b64decode(raw)
        out = os.path.join(dest, p[len(prefix):])
        os.makedirs(os.path.dirname(out), exist_ok=True)
        with open(out, "wb") as f:
            f.write(data)


# ---- drive -------------------------------------------------------------------------------------
def drive_listing(folder_id):
    page = http(f"https://drive.google.com/embeddedfolderview?id={folder_id}").decode("utf-8", "replace")
    rows = []
    for m in re.finditer(r'<a href="https://drive.google.com/file/d/([^/]+)/[^"]*"[^>]*>.*?'
                         r'<div class="flip-entry-title">(.*?)</div>.*?'
                         r'<div class="flip-entry-last-modified"><div>(.*?)</div>', page, re.S):
        rows.append({"file_id": m.group(1), "file_name": html.unescape(m.group(2)),
                     "modified": html.unescape(m.group(3))})
    if not rows and "flip-entry" not in page:
        raise RuntimeError(f"could not read Drive folder {folder_id} (is it still public?)")
    return rows


def drive_download(file_id):
    return http(f"https://drive.usercontent.google.com/download?id={file_id}&export=download&confirm=t", 120)


def drive_extract(zip_bytes, src, dest):
    """Unpack the skill folder from the zip (a nested .skill is itself a zip)."""
    z = zipfile.ZipFile(io.BytesIO(zip_bytes))
    inner = z
    if src.get("zip_path"):
        names = [n for n in z.namelist() if n.endswith(src["zip_path"])]
        if not names:
            raise RuntimeError(f"{src['zip_path']} not in {src['file_name']}")
        inner = zipfile.ZipFile(io.BytesIO(z.read(names[0])))
    sub = src["skill_subdir"].rstrip("/") + "/"
    members = [n for n in inner.namelist() if not n.endswith("/") and "/__MACOSX/" not in "/" + n
               and os.path.basename(n) != ".DS_Store"]
    # the skill may sit at the root of the archive or under <skill_subdir>/, possibly nested once more
    roots = sorted({n[: n.index(sub) + len(sub)] for n in members if sub in n}, key=len)
    base = roots[0] if roots else ""
    picked = [n for n in members if n.startswith(base)]
    if not any(os.path.basename(n) == "SKILL.md" for n in picked):
        raise RuntimeError(f"no SKILL.md for {src['skill_subdir']} in the archive")
    for n in picked:
        out = os.path.join(dest, n[len(base):])
        os.makedirs(os.path.dirname(out), exist_ok=True)
        with open(out, "wb") as f:
            f.write(inner.read(n))


# ---- commands ----------------------------------------------------------------------------------
SOURCES_DIR = os.path.expanduser("~/.agents/sources")


def checkout_dir(name, entry=None):
    """A checkout that IS one skill lives at ~/.agents/skills/<name>. A checkout that ships several
    skills (source.subskills) lives at ~/.agents/sources/<name>, and each listed sub-skill is linked
    into ~/.agents/skills/<basename> by install.sh, so there is still one copy on disk."""
    if entry and entry["source"].get("subskills"):
        return os.path.join(SOURCES_DIR, name)
    return os.path.join(INSTALLED, name)


def git(d, *args):
    r = subprocess.run(["git", "-C", d, *args], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:300])
    return r.stdout.strip()


def check_one(name, entry):
    src, pin = entry["source"], entry.get("pin", {})
    if src["type"] == "checkout":
        d = checkout_dir(name, entry)
        if not os.path.isdir(os.path.join(d, ".git")):
            raise RuntimeError(f"~/.agents/skills/{name} is not a clone of {src['repo']} (run ./install.sh)")
        branch = src.get("branch", "main")
        git(d, "fetch", "-q", "origin", branch)
        new = git(d, "log", "--format=%h %ad %s", "--date=short", f"HEAD..origin/{branch}").splitlines()
        dirty = git(d, "status", "--porcelain")
        head = git(d, "log", "-1", "--format=%h %ad", "--date=short")
        return {"name": name, "outdated": bool(new), "pinned": f"{head} (local checkout{', UNCOMMITTED CHANGES' if dirty else ''})",
                "latest": "; ".join(new[:5]) + (" …" if len(new) > 5 else ""), "behind": len(new),
                "source": f"checkout:{src['repo']}"}
    if src["type"] == "github":
        latest = github_latest(src)
        behind = github_count_since(src, pin["commit"])
        outdated = not latest["commit"].startswith(pin["commit"][:7])
        return {"name": name, "outdated": outdated, "pinned": f"{pin['commit']} ({pin['date']})",
                "latest": f"{latest['commit']} ({latest['date']}) {latest['message']}",
                "behind": behind, "source": f"github:{src['repo']}/{src['path']}"}
    if src["type"] == "drive":
        rows = drive_listing(src["folder_id"])
        same = [r for r in rows if r["file_id"] == src["file_id"]]
        cur = same[0] if same else (rows[0] if rows else None)
        if cur is None:
            raise RuntimeError("folder is empty")
        changed = (cur["file_id"] != src["file_id"] or cur["file_name"] != src["file_name"]
                   or cur["modified"] != pin["drive_modified"])
        extra = [r["file_name"] for r in rows if r["file_id"] != src["file_id"]]
        return {"name": name, "outdated": changed, "pinned": f"{src['file_name']} ({pin['drive_modified']})",
                "latest": f"{cur['file_name']} ({cur['modified']})" + (f"; also in folder: {', '.join(extra)}" if extra else ""),
                "behind": None, "source": f"drive:{src['folder_id']}", "_row": cur}
    raise RuntimeError(f"unknown source type {src['type']}")


def cmd_list(data):
    for name, e in sorted(data["skills"].items()):
        s, p = e["source"], e.get("pin", {})
        where = (f"{s['repo']}/{s['path']}" if s["type"] == "github" else s["repo"] if s["type"] == "checkout"
                 else f"Drive {s['file_name']} ({s.get('publisher', '')})")
        ver = p.get("commit") or p.get("version") or f"git checkout ({s.get('branch', 'main')})"
        print(f"{name:22} {s['type']:7} {where}  @ {ver}")


def cmd_outdated(data, as_json=False):
    results, errors = [], []
    for name, e in sorted(data["skills"].items()):
        try:
            results.append(check_one(name, e))
        except Exception as ex:  # noqa: BLE001 - a source being unreachable is reported, never fatal
            errors.append({"name": name, "error": str(ex)})
    for r in results:
        r.pop("_row", None)
    if as_json:
        print(json.dumps({"results": results, "errors": errors}, indent=2))
    else:
        for r in results:
            mark = "OUTDATED" if r["outdated"] else "ok      "
            behind = f"  ({r['behind']} newer commit{'s' if r['behind'] != 1 else ''})" if r["outdated"] and r["behind"] else ""
            print(f"{mark} {r['name']:22} pinned {r['pinned']}" + (f"\n         {'':22} latest {r['latest']}{behind}" if r["outdated"] else ""))
        for e in errors:
            print(f"ERROR    {e['name']:22} {e['error']}")
    if not errors:
        os.makedirs(os.path.dirname(STAMP), exist_ok=True)
        with open(STAMP, "w") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S") + "\n")
    if errors:
        return 3
    return 10 if any(r["outdated"] for r in results) else 0


def cmd_upgrade(data, names):
    if names == ["--all"]:
        names = [n for n, e in sorted(data["skills"].items()) if check_one(n, e)["outdated"]]
        if not names:
            print("everything is up to date")
            return 0
    zips = {}
    for name in names:
        if name not in data["skills"]:
            die(f"{name} is not in vendor/sources.json (see `skills-upstream list`)")
        e = data["skills"][name]
        src, pin = e["source"], e.get("pin", {})
        if src["type"] == "checkout":
            d = checkout_dir(name, e)
            before = git(d, "rev-parse", "--short", "HEAD")
            print(git(d, "pull", "--ff-only", "-q", "origin", src.get("branch", "main")) or f"{name}: pulled")
            print(f"{name}: {before} -> {git(d, 'rev-parse', '--short', 'HEAD')} (git checkout; nothing to commit in desk-skills)")
            continue
        tmp = tempfile.mkdtemp(prefix=f"skills-upstream-{name}-")
        try:
            if src["type"] == "github":
                latest = github_latest(src)
                github_fetch(src, latest["commit"], tmp)
                new_pin = {"commit": latest["commit"], "date": latest["date"]}
                label = f"{pin['commit']} -> {latest['commit']} ({latest['date']}: {latest['message']})"
            else:
                row = check_one(name, e)["_row"]
                if row["file_id"] not in zips:
                    zips[row["file_id"]] = drive_download(row["file_id"])
                blob = zips[row["file_id"]]
                drive_extract(blob, {**src, "file_name": row["file_name"]}, tmp)
                src.update({"file_id": row["file_id"], "file_name": row["file_name"]})
                new_pin = {**pin, "drive_modified": row["modified"], "zip_sha256": hashlib.sha256(blob).hexdigest()}
                new_pin["version"] = f"{row['file_name']} ({row['modified']})"
                label = f"{pin.get('version')} -> {new_pin['version']}"
            dest = os.path.join(VENDOR, name)
            if tree_sha256(tmp) == (tree_sha256(dest) if os.path.isdir(dest) else ""):
                print(f"{name}: upstream content is identical to vendor/{name}; pin updated only")
            else:
                shutil.rmtree(dest, ignore_errors=True)
                shutil.copytree(tmp, dest)
                print(f"{name}: {label}")
            e["pin"] = new_pin
            e["tree_sha256"] = tree_sha256(dest)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    save(data)
    print("\nReview:  git -C", ROOT, "diff --stat -- vendor/   then install with ./install.sh")
    return 0


PLUGINS_DIR = os.path.expanduser("~/.claude/plugins")


def cmd_plugins(as_json=False):
    """Compare each installed plugin with the commit its marketplace pins.

    Marketplaces pin a plugin to a git sha. A plugin reports either that sha (as its version) or a
    semver from its own .claude-plugin/plugin.json; for the latter, the pinned sha's plugin.json is
    read from GitHub. Anything that cannot be compared is reported as unknown, never as current."""
    installed = json.loads(subprocess.run(["claude", "plugin", "list", "--json"], capture_output=True,
                                          text=True, check=True).stdout or "[]")
    rows = []
    for p in installed:
        name, _, market = p["id"].partition("@")
        row = {"plugin": p["id"], "installed": p.get("version"), "latest": None, "status": "unknown", "note": ""}
        mfile = os.path.join(PLUGINS_DIR, "marketplaces", market, ".claude-plugin", "marketplace.json")
        try:
            entry = next(e for e in json.load(open(mfile))["plugins"] if e.get("name") == name)
        except Exception:  # noqa: BLE001
            row["note"] = f"no entry in {market}'s marketplace.json"
            rows.append(row)
            continue
        src = entry.get("source")
        if isinstance(src, dict) and src.get("sha"):
            sha = src["sha"]
            inst = str(p.get("version") or "")
            if re.fullmatch(r"[0-9a-f]{7,40}", inst):
                row["latest"] = sha[:12]
                row["status"] = "ok" if sha.startswith(inst) or inst.startswith(sha[:len(inst)]) else "outdated"
            else:
                m = re.search(r"github\.com[/:]([^/]+/[^/.]+)", src.get("url", "") or src.get("repo", ""))
                path = (src.get("path") or "").strip("/")
                if m:
                    try:
                        mani = gh("api", f"repos/{m.group(1)}/contents/{(path + '/') if path else ''}.claude-plugin/plugin.json?ref={sha}",
                                  "--jq", ".content")
                        import base64
                        ver = json.loads(base64.b64decode(mani)).get("version")
                        row["latest"] = ver
                        row["status"] = "ok" if ver == inst else ("outdated" if ver else "unknown")
                    except Exception as ex:  # noqa: BLE001
                        row["note"] = f"could not read plugin.json at {sha[:9]}: {str(ex)[:80]}"
                else:
                    row["note"] = "pinned source is not a GitHub repo"
        elif isinstance(src, str) and src.startswith("./"):
            # The plugin lives inside the marketplace itself. `claude plugin marketplace update`
            # refreshes that copy, so the installed plugin is current exactly when its folder
            # matches the marketplace's folder for it.
            mdir = os.path.join(PLUGINS_DIR, "marketplaces", market, src[2:])
            inst_dir = p.get("installPath") or ""
            if os.path.isdir(mdir) and os.path.isdir(inst_dir):
                same = tree_sha256(mdir) == tree_sha256(inst_dir)
                row["latest"] = "marketplace copy"
                row["status"] = "ok" if same else "outdated"
                if not same:
                    row["note"] = "changed: " + ", ".join(tree_changes(mdir, inst_dir)[:6])
            else:
                row["note"] = "marketplace or installed folder not found"
        elif entry.get("version"):
            row["latest"] = entry["version"]
            row["status"] = "ok" if entry["version"] == p.get("version") else "outdated"
        else:
            row["note"] = "marketplace entry has no pinned sha or version"
        rows.append(row)
    if as_json:
        print(json.dumps(rows, indent=2))
    else:
        for r in rows:
            mark = {"ok": "ok      ", "outdated": "OUTDATED", "unknown": "UNKNOWN "}[r["status"]]
            print(f"{mark} {r['plugin']:48} installed {r['installed']}" + (f" -> {r['latest']}" if r["status"] == "outdated" else "") + (f"  ({r['note']})" if r["note"] else ""))
    return 10 if any(r["status"] == "outdated" for r in rows) else 0


def cmd_verify(data):
    bad = 0
    missing = set()   # origins reported NOT INSTALLED here, so cmd_links does not repeat them
    for name, e in sorted(data["skills"].items()):
        if e["source"]["type"] == "checkout":
            d = checkout_dir(name, e)
            try:
                url = origin_url(d)
                if url is None:
                    print(f"NOT INSTALLED  {tilde(d)} (run ./install.sh)")
                else:
                    ok = same_repo(url, e["source"]["repo"])
                    dirty = git(d, "status", "--porcelain")
                    print(("ok       " if ok and not dirty else "CHANGED  ") + f"{name} (git checkout of {e['source']['repo']}{'' if ok else ', WRONG REMOTE ' + url}{', has uncommitted changes' if dirty else ''})")
                    bad |= int(not ok or bool(dirty))
                    continue
            except (Unverified, RuntimeError) as ex:
                print(f"UNVERIFIED  {tilde(d)}: git could not read it ({str(ex).splitlines()[0] if str(ex) else ex})")
            missing.add(name)   # links counts it but does not report it twice
            bad = 1
            continue
        v = os.path.join(VENDOR, name)
        if not os.path.isdir(v):
            print(f"MISSING  vendor/{name}")
            bad = 1
            continue
        vh = tree_sha256(v)
        if e.get("tree_sha256") and e["tree_sha256"] != vh:
            print(f"CHANGED  vendor/{name} differs from sources.json tree_sha256 (edited by hand?)")
            bad = 1
        inst = os.path.join(INSTALLED, name)
        if not os.path.isdir(inst):
            print(f"NOT INSTALLED  ~/.agents/skills/{name} (run ./install.sh)")
            missing.add(name)
            bad = 1
        elif tree_sha256(inst) != vh:
            print(f"DRIFTED  ~/.agents/skills/{name} differs from vendor/{name} (run ./install.sh)")
            bad = 1
        else:
            print(f"ok       {name}")
    print()
    bad |= cmd_links(data, missing)
    return bad


def expected_skills(data):
    """Every skill install.sh puts in ~/.agents/skills, in the order it installs them: desk's own
    skills/desk-*, every vendor/<name> folder (dot-folders skipped, as the installer's glob skips
    them), then the checkout entries (one per listed sub-skill, named by its basename, when the entry
    has `subskills`). Each is (name, origin, kind, checkout): origin is the sources.json key or folder
    it came from; checkout is None, or for a checkout entry {repo, branch, clone, sub, path}, where
    path is the folder ~/.agents/skills/<name> must resolve to: the sub-skill's folder in the clone,
    or for a single-skill checkout the clone itself (sub None)."""
    out = []
    for folder, kind in ((os.path.join(ROOT, "skills"), "desk"), (VENDOR, "vendor")):
        for d in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
            if d.startswith(".") or not os.path.isdir(os.path.join(folder, d)):
                continue
            if kind == "vendor" or d.startswith("desk-"):
                out.append((d, d, kind, None))
    for name, e in sorted(data["skills"].items()):
        src = e["source"]
        if src["type"] != "checkout":
            continue
        subs = [s.rstrip("/") for s in src.get("subskills") or []]
        co = {"repo": src["repo"], "branch": src.get("branch", "main"),
              "clone": checkout_dir(name, e)}
        out += ([(os.path.basename(s), name, f"checkout {name}", {**co, "sub": s, "path": os.path.join(co["clone"], s)})
                 for s in subs]
                or [(name, name, f"checkout {name}", {**co, "sub": None, "path": co["clone"]})])
    return out


def tilde(path):
    """~/... for a path under HOME, checked against HOME's real path too (macOS /var -> /private/var)."""
    for home in (os.path.expanduser("~"), os.path.realpath(os.path.expanduser("~"))):
        if path == home or path.startswith(home + os.sep):
            return "~" + path[len(home):]
    return path


def agents_side(name, kind, co, inst):
    """What is wrong with ~/.agents/skills/<name> itself, as the lines to print, or None. For a
    checkout it must be the clone (a single skill) or resolve into it (a sub-skill), as install.sh's
    link_skill leaves it: any other folder with a SKILL.md would pass a SKILL.md test while Claude Code
    loads the wrong copy. Local git only; never fetches."""
    if co and co["sub"] and os.path.isdir(co["clone"]) and not os.path.isfile(os.path.join(co["path"], "SKILL.md")):
        ref = f"origin/{co['branch']}"
        upstream_has = subprocess.run(["git", "-C", co["clone"], "cat-file", "-e", f"{ref}:{co['sub']}/SKILL.md"],
                                      capture_output=True).returncode == 0
        origin = kind.split(" ", 1)[1]
        lines = [f"NOT IN CLONE  {co['sub']} is missing from your local clone {tilde(co['clone'])} ({kind})"]
        if upstream_has:
            lines += [f"         it is in {ref} as last fetched; the clone was never pulled (install.sh never pulls)",
                      f"         fix: skills-upstream upgrade {origin}"]
        else:
            lines += [f"         fix: skills-upstream upgrade {origin} (it fetches and pulls); if it is still missing,",
                      f"         it is gone from {co['repo']}: remove it from `subskills` for {origin} in vendor/sources.json"]
        return lines
    if not os.path.isfile(os.path.join(inst, "SKILL.md")):
        return [f"NOT INSTALLED  ~/.agents/skills/{name} has no SKILL.md ({kind})", "         fix: run ./install.sh"]
    if co and co["sub"] and os.path.realpath(inst) != os.path.realpath(co["path"]):
        where = f"resolves to {tilde(os.path.realpath(inst))}" if os.path.islink(inst) else "is a real folder"
        return [f"WRONG COPY  ~/.agents/skills/{name} {where}, not {tilde(co['path'])} in the {co['repo']} clone ({kind})",
                f"         fix: ln -sfn {tilde(co['path'])} ~/.agents/skills/{name}" if os.path.islink(inst)
                else "         fix: run ./install.sh (it moves that aside to a backup, then links)"]
    if co and not co["sub"]:
        try:
            clone = is_clone_of(inst, co["repo"])
        except Unverified as ex:
            return [f"UNVERIFIED  ~/.agents/skills/{name}: git could not read its origin ({ex}) ({kind})",
                    f"         check it by hand: git -C ~/.agents/skills/{name} remote get-url origin"]
    if co and not co["sub"] and not clone:
        return [f"WRONG COPY  ~/.agents/skills/{name} is not a git clone of {co['repo']} ({kind})",
                f"         fix: run ./install.sh (it moves that aside to a backup, then clones {co['repo']})"]
    return None


def origin_slug(url):
    """(host, owner/repo) from a git remote URL, lower-cased (GitHub names are case-insensitive), or
    None. Takes https://[user[:token]@]host[:port]/o/r[.git][/], ssh://[user@]host[:port]/o/r[.git]
    and scp-style [user@]host:o/r[.git]; a path of anything but exactly two parts is None, so
    o/r-fork, a/o/r and a local path never pass as o/r."""
    u = url.strip()
    m = re.match(r"^[a-z][a-z0-9+.-]*://(?:[^@/]*@)?([^/:@]+)(?::\d*)?/(.*)$", u, re.I) \
        or re.match(r"^(?:[^@/:]+@)?([^/:@]+):(?!/)(.*)$", u)
    if not m:
        return None
    host, path = m.group(1), m.group(2).strip("/")
    if path.lower().endswith(".git"):
        path = path[:-4]
    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    return host.lower(), path.lower()


def same_repo(url, repo):
    """The ONE remote test, used by links, verify and (via `is-clone-of`) install.sh: the origin
    names exactly github.com/<repo>. Only github.com, because install.sh clones a missing or wrong
    checkout with `gh repo clone owner/repo`; see unsupported_hosts()."""
    return origin_slug(url) == ("github.com", repo.strip().strip("/").lower())


def unsupported_hosts(data):
    """Error lines for any checkout that records a source.host. install.sh can only clone from
    github.com, so honouring another host here would let install.sh replace a valid clone with a
    GitHub one that links then rejects."""
    return [f"ERROR    {n}: source.host is not supported; checkouts are cloned from github.com with gh"
            for n, e in sorted(data["skills"].items()) if e["source"].get("host")]


class Unverified(Exception):
    """git could not say what a folder's origin is (dubious ownership, an unreadable or corrupt
    config): neither a clone nor a non-clone, so nothing may be moved aside on its account."""


def origin_url(d):
    """The origin URL of the clone at d, or None when d is CONFIRMED not a clone: no .git of its own
    (so a parent repo never answers for it), or no origin remote (`git remote get-url` exits 2,
    "No such remote"). Any other git failure raises Unverified with git's first line. No fetch."""
    if not os.path.isdir(os.path.join(d, ".git")):
        return None
    r = subprocess.run(["git", "-C", d, "remote", "get-url", "origin"], capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout.strip()
    if r.returncode == 2:
        return None
    raise Unverified(((r.stderr or r.stdout).strip().splitlines() or [f"git exit {r.returncode}"])[0])


def is_clone_of(d, repo):
    """install.sh's own test that a checkout folder is the clone it wants: an origin that is exactly
    the repo. True or False only when git can say; raises Unverified when it cannot."""
    url = origin_url(d)
    return url is not None and same_repo(url, repo)


def cmd_links(data, already=()):
    """Claude Code loads a skill only from ~/.claude/skills/<name>/SKILL.md, so a skill installed in
    ~/.agents/skills with no link there is "Unknown skill" (seen 2026-09-28: three of 68, cause never
    reproduced), and one whose link lands on some other copy runs that copy, stale, while everything
    looks fine. This finds both, whatever caused them. Same rules as install.sh: in LINK_MODE=each,
    ~/.claude/skills/<name> must resolve to the same folder as ~/.agents/skills/<name> (the test its
    linking loop uses); when ~/.claude/skills itself resolves to ~/.agents/skills there are no per-skill
    links, so a gap there means the skill is not installed. `already` holds origins the caller has
    reported as not installed, counted here but not printed twice. Only reads."""
    skills = expected_skills(data)
    errors = unsupported_hosts(data)
    for line in errors:
        print(line)
    agents = os.path.realpath(INSTALLED) if os.path.isdir(INSTALLED) else None
    if not os.path.isdir(CLAUDE_SKILLS):
        if os.path.islink(CLAUDE_SKILLS):
            print("UNLINKED ~/.claude/skills is a broken link, so no skill is reachable")
            print("         fix: repair or remove ~/.claude/skills, then run ./install.sh")
        elif not os.path.lexists(CLAUDE_SKILLS):
            print("UNLINKED ~/.claude/skills is not created yet, so no skill is reachable")
            print("         fix: run ./install.sh (it creates it)")
        else:
            print("UNLINKED ~/.claude/skills is a file, not a directory, so no skill is reachable")
            print("         fix: move it aside, then run ./install.sh")
        print(f"{len(skills)} skills: 0 reachable from ~/.claude/skills, {len(skills)} not")
        return 1
    same = os.path.realpath(CLAUDE_SKILLS) == agents
    bad = 0
    clones = {}   # origin -> "ok", "wrong" or "unverified" for its multi-skill clone, checked once each
    for name, origin, kind, co in skills:
        link, inst = os.path.join(CLAUDE_SKILLS, name), os.path.join(INSTALLED, name)
        # A multi-skill checkout's aliases are only as good as the clone they point into: a stale copied
        # tree or another repo's clone would pass every per-alias test. Reported once per checkout.
        if co and co["sub"] and os.path.isdir(co["clone"]):
            if origin not in clones:
                try:
                    clones[origin] = "ok" if is_clone_of(co["clone"], co["repo"]) else "wrong"
                except Unverified as ex:
                    clones[origin] = "unverified"
                    if origin not in already:
                        print(f"UNVERIFIED  {tilde(co['clone'])}: git could not read its origin ({ex}) ({kind}; "
                              f"none of its sub-skills counts as reachable)")
                        print(f"         check it by hand: git -C {tilde(co['clone'])} remote get-url origin")
                if clones[origin] == "wrong" and origin not in already:
                    print(f"WRONG COPY  {tilde(co['clone'])} is not a git clone of {co['repo']} ({kind}; "
                          f"none of its sub-skills counts as reachable)")
                    print(f"         fix: run ./install.sh (it moves that aside to a backup, then clones {co['repo']})")
            if clones[origin] != "ok":
                bad += 1
                continue
        problem = agents_side(name, kind, co, inst)
        if problem:
            bad += 1
            if origin not in already:
                print("\n".join(problem))
            continue
        if same:
            continue   # ~/.claude/skills/<name> IS ~/.agents/skills/<name>
        if os.path.isfile(os.path.join(link, "SKILL.md")) and os.path.realpath(link) == os.path.realpath(inst):
            continue
        bad += 1
        fix_ln = f"         fix: ln -sfn ~/.agents/skills/{name} ~/.claude/skills/{name}"
        fix_install = "         fix: run ./install.sh (it moves that aside to a backup, then links)"
        if os.path.isfile(os.path.join(link, "SKILL.md")):
            where = (f"resolves to {tilde(os.path.realpath(link))}" if os.path.islink(link)
                     else "is a real folder with its own SKILL.md")
            print(f"SHADOWED ~/.claude/skills/{name} {where}, not ~/.agents/skills/{name}, "
                  f"so Claude Code runs that copy ({kind})")
            print(fix_ln if os.path.islink(link) else fix_install)
        elif os.path.islink(link) or not os.path.lexists(link):
            state = "is a link that reaches no SKILL.md" if os.path.islink(link) else "does not exist"
            print(f"UNLINKED ~/.claude/skills/{name} {state} ({kind})")
            print(fix_ln)
        else:
            print(f"UNLINKED ~/.claude/skills/{name} is a real {'folder' if os.path.isdir(link) else 'file'} "
                  f"with no SKILL.md, not a link ({kind})")
            print(fix_install)
    mode = "; ~/.claude/skills resolves to ~/.agents/skills, so no per-skill links are needed" if same else ""
    print(f"{len(skills)} skills: {len(skills) - bad} reachable from ~/.claude/skills, {bad} not{mode}"
          + (f"; {len(errors)} sources.json error(s)" if errors else ""))
    return int(bad > 0 or bool(errors))


AREAS = os.path.join(ROOT, "desk", "skill-areas.json")
INDEX = os.path.join(INSTALLED, "skill-index")
RULE = os.path.expanduser("~/.claude/rules/desk-skill-index.md")
BUDGET = 0.003   # of the context window, for the skill listing; Claude Code's default is 0.01


def frontmatter(path):
    """name, description, when_to_use and disable-model-invocation from a SKILL.md, or None."""
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not m:
        return None
    out, key, buf = {}, None, []

    def flush():
        if key:
            out[key] = " ".join(x.strip() for x in buf if x.strip()).strip().strip("\"'")

    for line in m.group(1).splitlines():
        km = re.match(r"^([A-Za-z_-]+):\s*(.*)$", line)
        if km:
            flush()
            key, first = km.group(1), km.group(2)
            buf = [] if re.fullmatch(r"[>|][-+]?", first.strip()) else [first]
        elif key:
            buf.append(line)
    flush()
    return out


def overrides():
    """skillOverrides from user settings: which skills Claude is not shown at all."""
    try:
        s = json.load(open(os.path.expanduser("~/.claude/settings.json")))
    except (OSError, ValueError):
        return {}, {}
    return s.get("skillOverrides") or {}, s.get("enabledPlugins") or {}


def installed_skills():
    """(name, source, SKILL.md path) for every skill Claude Code would list to the model."""
    found = {}
    if os.path.isdir(CLAUDE_SKILLS):
        for d in sorted(os.listdir(CLAUDE_SKILLS)):
            p = os.path.join(CLAUDE_SKILLS, d, "SKILL.md")
            if d.startswith(".") or d in ("synced", "skill-index") or not os.path.isfile(p):
                continue
            found.setdefault(d, ("personal", p))
    synced = os.path.join(CLAUDE_SKILLS, "synced")
    if os.path.isdir(synced):
        for d in sorted(os.listdir(synced)):
            p = os.path.join(synced, d, "SKILL.md")
            fm = frontmatter(p)
            if fm and fm.get("name"):
                found.setdefault(f"anthropic-skills:{fm['name']}", ("claude.ai", p))
    _, enabled = overrides()
    try:
        plugins = json.load(open(os.path.expanduser("~/.claude/plugins/installed_plugins.json")))["plugins"]
    except (OSError, ValueError, KeyError):
        plugins = {}
    for pid, installs in sorted(plugins.items()):
        if enabled.get(pid) in (None, False) or not installs:
            continue
        root = os.path.join(installs[0].get("installPath", ""), "skills")
        if not os.path.isdir(root):
            continue
        for d in sorted(os.listdir(root)):
            p = os.path.join(root, d, "SKILL.md")
            if os.path.isfile(p):
                fm = frontmatter(p) or {}
                found.setdefault(f"{pid.split('@')[0]}:{fm.get('name') or d}", (f"plugin {pid.split('@')[0]}", p))
    return found


def write_json(path, data):
    """Replace the file path resolves to (a symlinked settings.json stays a symlink), keeping its mode."""
    real = os.path.realpath(path)
    fd, tmp = tempfile.mkstemp(prefix=".desk-", suffix=".tmp", dir=os.path.dirname(real))
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        if os.path.exists(real):
            shutil.copymode(real, tmp)
        os.replace(tmp, real)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def name_only(names, settings, check):
    """List each of names to Claude by name only (skillOverrides), never changing an entry the user set.
    Plugin skills are skipped: skillOverrides does not reach them. Exit 0 all set, 1 some missing
    (--check) or added, 2 unreadable settings."""
    try:
        with open(settings) as f:
            raw = f.read()
        data = json.loads(raw) if raw.strip() else {}
    except FileNotFoundError:
        data = {}
    except (OSError, ValueError):
        print(f"skill-index: {tilde(settings)} is not valid JSON", file=sys.stderr)
        return 2
    ov = data.get("skillOverrides") or {}
    missing = sorted(n for n in names if n not in ov)
    rule_ok = os.path.isfile(RULE)
    if check or (not missing and rule_ok and "skillListingBudgetFraction" in data):
        print(f"skill-index: {len(names) - len(missing)}/{len(names)} skills already have a listing override")
        return 1 if (missing or not rule_ok) else 0
    ov.update({n: "name-only" for n in missing})
    data["skillOverrides"] = ov
    # Plugin skills cannot be set name-only, and Claude Code fills whatever listing budget it has, so
    # the saving comes from a smaller budget: at 1% (the default) plugin descriptions grew to fill the
    # room the name-only skills freed (measured 2026-09-30: ~30,000 characters either way). A value the
    # user set is kept.
    data.setdefault("skillListingBudgetFraction", BUDGET)
    write_json(settings, data)
    # The listing drops descriptions from the least-invoked skills first, which could include
    # skill-index itself, so the pointer to it also lives in an always-loaded rule file.
    os.makedirs(os.path.dirname(RULE), exist_ok=True)
    with open(RULE, "w") as f:
        f.write("Installed by desk-skills (`skills-upstream index --name-only`); re-run install.sh to refresh.\n\n"
                "Most skills are listed to you by name only. When a request might need a skill and its name alone "
                "does not settle which, invoke the `skill-index` skill first: it maps each area to one file of full "
                "descriptions. Read only that area file, then load the skill by its exact name.\n")
    rec = os.path.expanduser("~/.claude/desk/skill-index.name-only.json")
    os.makedirs(os.path.dirname(rec), exist_ok=True)
    prev = json.load(open(rec)) if os.path.exists(rec) else []
    json.dump(sorted(set(prev) | set(missing)), open(rec, "w"), indent=1)
    print(f"skill-index: {len(missing)} skills now listed by name only (recorded in {tilde(rec)})")
    return 0


def cmd_index(quiet=False, only_names=None):
    """Write ~/.agents/skills/skill-index: a short map of areas plus one file of full descriptions per area."""
    import fnmatch
    spec = json.load(open(AREAS))
    areas, exclude = spec["areas"], spec.get("exclude", [])
    hidden, _ = overrides()
    rows = {a["id"]: [] for a in areas}
    rows["other"] = []
    for name, (source, path) in installed_skills().items():
        fm = frontmatter(path) or {}
        if hidden.get(name) in ("off", "user-invocable-only") or fm.get("disable-model-invocation", "").lower() == "true" \
                or any(fnmatch.fnmatchcase(name, g) for g in exclude):
            continue
        area = next((a["id"] for a in areas if any(fnmatch.fnmatchcase(name, g) for g in a["match"])), "other")
        desc = fm.get("description") or "(no description in its SKILL.md)"
        if fm.get("when_to_use"):
            desc += f" When to use: {fm['when_to_use']}"
        rows[area].append((name, source, desc))
    titles = {a["id"]: (a["title"], a["summary"]) for a in areas}
    titles["other"] = ("Other", "Skills no area in desk/skill-areas.json matches yet.")

    tmp = INDEX + ".tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(os.path.join(tmp, "areas"))
    today = time.strftime("%Y-%m-%d")
    total = sum(len(v) for v in rows.values())
    table = []
    for aid, skills in rows.items():
        if not skills:
            continue
        title, summary = titles[aid]
        table.append(f"| {title} | {summary} | `areas/{aid}.md` | {', '.join(n for n, _, _ in sorted(skills))} |")
        with open(os.path.join(tmp, "areas", f"{aid}.md"), "w") as f:
            f.write(f"# {title}\n\n{summary}\n\nLoad a skill with the Skill tool by its exact name.\n")
            for n, source, desc in sorted(skills):
                f.write(f"\n## {n}\n\n_{source}_\n\n{desc}\n")
    with open(os.path.join(tmp, "SKILL.md"), "w") as f:
        f.write(
            "---\nname: skill-index\ndescription: >-\n"
            "  The catalogue of every installed skill, sorted into areas (desk workflow, security and privacy,\n"
            "  legal, domain experts, UX and design, frontend, auth and payments, backend and data, infrastructure,\n"
            "  testing and review, process, marketing and SEO, documents and browser, Claude tooling). Most skills\n"
            "  are listed to you by name only: read this before choosing a skill whose name does not settle it, or\n"
            "  to check whether any skill covers the request. It points to one area file with full descriptions.\n"
            "---\n\n"
            f"# Skill index\n\nGenerated by `skills-upstream index` on {today} from {total} skills. Do not edit: "
            "change `desk/skill-areas.json` in desk-skills and re-run.\n\n"
            "1. Pick the area below that fits the request. If none fits, no skill applies: say so and carry on.\n"
            "2. Read only that area's file (the path is relative to this skill's directory).\n"
            "3. Load the one skill whose description matches, by its exact name. A skill a rule or the user names is loaded regardless.\n\n"
            "| Area | Covers | Read | Skills |\n|---|---|---|---|\n" + "\n".join(table) + "\n")
    shutil.rmtree(INDEX, ignore_errors=True)
    os.replace(tmp, INDEX)
    link = os.path.join(CLAUDE_SKILLS, "skill-index")
    if not os.path.islink(link) and not os.path.exists(link):
        os.symlink(INDEX, link)
    if not quiet:
        print(f"skill-index: {total} skills in {sum(1 for v in rows.values() if v)} areas -> {tilde(INDEX)}")
    if only_names is not None:
        # personal and claude.ai skills; plugin skills cannot be overridden, and skill-index stays described
        names = [n for aid, v in rows.items() for n, src, _ in v if src in ("personal", "claude.ai")]
        return name_only(names, only_names["settings"], only_names["check"])
    if rows["other"]:
        print(f"skill-index: no area for {', '.join(n for n, _, _ in rows['other'])} (add a glob to desk/skill-areas.json)")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "index":   # needs no sources.json: it reads what is installed
        settings = os.path.expanduser("~/.claude/settings.json")
        if "--settings" in rest:
            settings = rest[rest.index("--settings") + 1]
        mode = {"settings": settings, "check": "--check" in rest} if "--name-only" in rest else None
        return cmd_index("--quiet" in rest, mode)
    if cmd == "is-clone-of":   # needs no sources.json; install.sh passes the entry's repo
        if len(rest) != 2:
            die("usage: skills-upstream is-clone-of <dir> <owner/repo>")
        try:
            return 0 if is_clone_of(rest[0], rest[1]) else 1
        except Unverified as ex:   # inconclusive: install.sh WARNs and leaves the folder alone
            print(f"skills-upstream: is-clone-of: git could not read the origin of {rest[0]}: {ex}", file=sys.stderr)
            return 2
        except Exception as ex:  # noqa: BLE001 - exit 1 means "not the clone" and install.sh moves it aside
            print(f"skills-upstream: is-clone-of: {ex}", file=sys.stderr)
            return 2
    data = load()
    if cmd == "list":
        cmd_list(data)
        return 0
    if cmd in ("outdated", "check"):
        return cmd_outdated(data, "--json" in rest)
    if cmd == "upgrade":
        if not rest:
            die("usage: skills-upstream upgrade <name>... | --all")
        return cmd_upgrade(data, rest)
    if cmd == "verify":
        return cmd_verify(data)
    if cmd == "links":
        return cmd_links(data)
    if cmd == "plugins":
        return cmd_plugins("--json" in rest)
    if cmd == "rehash":
        for name, e in data["skills"].items():
            if e["source"]["type"] != "checkout":
                e["tree_sha256"] = tree_sha256(os.path.join(VENDOR, name))
        save(data)
        print(f"recorded {len(data['skills'])} tree hashes")
        return 0
    if cmd == "stamp-age-days":
        try:
            print(int((time.time() - os.path.getmtime(STAMP)) // 86400))
        except OSError:
            print(9999)
        return 0
    die(f"unknown command {cmd} (try --help)")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
