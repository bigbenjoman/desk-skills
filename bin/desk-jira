#!/usr/bin/env bash
# Direct Jira Cloud REST access for the desk-* skills, configured PER REPO.
# Replaces the claude.ai Atlassian connector for scripted/agent use: one hop, no proxy.
#
# Which Jira: the repo you run it in. Its slug, as `desk-env where` resolves it (lower-case
# `owner__name` of the origin remote from any host; `local__<name>-<hash>` without one), picks
#   ~/.config/desk/repos/<slug>/config.md         §4 Jira site, Jira project, Priority
#   ~/.config/desk/repos/<slug>/jira-email        your Atlassian login email for that site (chmod 600)
#   ~/.config/desk/repos/<slug>/atlassian-token   an API token (chmod 600)
# so two repos can use two Atlassian sites with two logins. `desk-jira where` shows what it resolved.
#
# Setup, once per repo (or let /desk-setup do it):
#   d="$(desk-jira where --dir)"; mkdir -p "$d" && chmod 700 "$d"
#   printf %s you@example.com > "$d/jira-email" && chmod 600 "$d/jira-email"
#   printf %s '<your atlassian api token>' > "$d/atlassian-token" && chmod 600 "$d/atlassian-token"
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# The token is never stored in this script and must never be committed.
#
# Auth: Basic (email + API token). Text-bearing calls use API v2, which accepts plain strings on
# Cloud; v3 would demand ADF JSON. Search uses /rest/api/3/search/jql, because Cloud has removed the
# old /search endpoints. A .md body (create's description, comment, edit description=@file.md) is
# converted from markdown to wiki markup, because v2 reads `## x` as a numbered list; a .md file that
# is already wiki markup, and every other body, is sent unchanged.
#
# Credentials reach curl as a config on stdin (curl -K -), never on argv. Files it sends must be
# inside the repo, $DESK_STATE or a temp dir. search/get/comments prove the login first, because
# Jira answers an anonymous search with 200 and no issues.
#
# Written for bash 3.2 as well as 4+/5, so it runs on stock macOS. Needs curl, jq and git; node to
# resolve the repo and read its config through desk-env.mjs (a built-in fallback resolves the repo
# by the same rules when desk-env.mjs is missing, but then there is no config to read); python3,
# standard library only, to convert a .md body.

set -euo pipefail

DESK_ENV_MJS="${DESK_ENV_MJS:-$HOME/.claude/desk/bin/desk-env.mjs}"

# `owner/name` from any git remote URL. The FALLBACK for when desk-env.mjs is missing, and a port of
# its ownerRepoFromUrl: any host (ssh aliases included), trailing slashes and .git dropped, and the
# last two path segments are the repo. Prints nothing for a URL that does not end in owner/name.
owner_repo_from_url() {
  local u="$1" path="" tail_re='(^|/)([^/[:space:]:]+)/([^/[:space:]:]+)$'
  u="${u#"${u%%[![:space:]]*}"}"; u="${u%"${u##*[![:space:]]}"}"
  while [[ "$u" == */ ]]; do u="${u%/}"; done
  u="${u%.git}"
  local -a prefixes=('^[A-Za-z][A-Za-z0-9+.-]*://[^/]+/(.*)$' '^[^@[:space:]/]+@[^:[:space:]/]+:(.*)$' '^[^:[:space:]/]+:(.*)$')
  local i
  for i in 0 1 2; do
    [[ "$u" =~ ${prefixes[$i]} ]] || continue
    path="${BASH_REMATCH[1]}"
    if [[ $i == 2 && "$path" == /* ]]; then continue; fi
    if [[ "$path" =~ $tail_re ]]; then printf '%s/%s' "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"; return; fi
  done
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# The fallback slug, by desk-env.mjs's rules: DESK_REPO_OVERRIDE, else owner__name of origin
# (lower-case), else local__<main checkout name>-<8 hex of its path>, else empty.
fallback_slug() {
  local or common root hash
  or="${DESK_REPO_OVERRIDE:-$(owner_repo_from_url "$(git remote get-url origin 2>/dev/null || true)")}"
  if [[ -n "$or" ]]; then lower "${or/\//__}"; return; fi
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  [[ -n "$common" ]] || return 0
  root=$(dirname "$common")
  if command -v shasum >/dev/null 2>&1; then hash=$(printf '%s' "$root" | shasum -a 1)
  else hash=$(printf '%s' "$root" | sha1sum); fi
  printf 'local__%s-%s' "$(lower "$(basename "$root")")" "${hash:0:8}"
}

# Which repo, and where its config and credentials live: desk-env.mjs `where` is the single source
# of truth. Its output is parsed, never eval'd.
SLUG="" CONFIG_PATH="" REPO_DIR=""
if [[ -r "$DESK_ENV_MJS" ]] && command -v node >/dev/null 2>&1; then
  sq="'"; esc="'\\''"   # desk-env quotes as '...' with each ' written '\''
  while IFS= read -r line; do
    k="${line%%=*}"; v="${line#*=}"; v="${v#$sq}"; v="${v%$sq}"; v=${v//"$esc"/$sq}
    case "$k" in SLUG) SLUG="$v" ;; CONFIG) CONFIG_PATH="$v" ;; CREDS) REPO_DIR="$v" ;; esac
  done < <(node "$DESK_ENV_MJS" where 2>/dev/null || true)
else
  SLUG=$(fallback_slug)
  if [[ -n "$SLUG" ]]; then
    REPO_DIR="${DESK_CONFIG_ROOT:-$HOME/.config/desk}/repos/$SLUG"
    CONFIG_PATH="${DESK_CONFIG:-$REPO_DIR/config.md}"
  fi
fi
[[ -n "$SLUG" ]] || REPO_DIR="${DESK_CONFIG_ROOT:-$HOME/.config/desk}/repos/(no repo)"

# One row of this repo's config, or empty. desk-env.mjs reads it (and resolves the repo itself, by
# the same rules as `where`), so there is one parser. Without desk-env there is no config to read.
cfg() {
  [[ -n "$SLUG" && -r "$DESK_ENV_MJS" ]] || return 0
  node "$DESK_ENV_MJS" get "$1" 2>/dev/null || true
}
# A §3 row as yes|ask|no|never|stop; empty without desk-env, which reads as not granted.
cfg_perm() {
  [[ -n "$SLUG" && -r "$DESK_ENV_MJS" ]] || return 0
  node "$DESK_ENV_MJS" perm "$1" 2>/dev/null || true
}
# First word of a row ('KAN "Voice PA"; Task, Bug' -> KAN); `none` reads as empty.
first_word_raw() { printf '%s' "$1" | awk '{print $1}' | tr -d '`,;' | tr '[:upper:]' '[:lower:]'; }
first_word() {
  local v; v=$(printf '%s' "$1" | awk '{print $1}' | tr -d '`,;')
  if [[ "$v" != none ]]; then printf '%s' "$v"; fi
}

SITE="${JIRA_SITE:-$(first_word "$(cfg jira-site)")}"
# The base URL: https://<site>. A site written with a scheme is kept as is, but plain http is only
# accepted for a local host (a test stub), so credentials never cross the network unencrypted. The
# host is parsed, not prefix-matched: http://localhost@evil.com and http://127.0.0.1.evil.com are
# remote hosts. A local site also bypasses any proxy, which would otherwise receive the token.
LOCAL_HTTP=0
case "$SITE" in
  https://*) BASE="${SITE%/}" ;;
  http://*)
    authority="${SITE#http://}"; authority="${authority%%[/?#]*}"
    case "$authority" in
      \[*) host="${authority%%]*}]" ;;
      *) host="${authority%%:*}" ;;
    esac
    port="${authority#"$host"}"
    case "$host" in 127.0.0.1|localhost|'[::1]') ;; *) host="" ;; esac
    if [[ -z "$host" ]] || ! [[ -z "$port" || "$port" =~ ^:[0-9]+$ ]]; then
      printf 'desk-jira: refusing plain http for %s: use https\n' "$SITE" >&2; exit 1
    fi
    BASE="${SITE%/}"; LOCAL_HTTP=1 ;;
  "") BASE="" ;;
  *) BASE="https://${SITE%/}" ;;
esac
PROJECT="${JIRA_PROJECT:-$(first_word "$(cfg jira-project)")}"
TOKEN_FILE="${JIRA_TOKEN_FILE:-$REPO_DIR/atlassian-token}"
EMAIL_FILE="${JIRA_EMAIL_FILE:-$REPO_DIR/jira-email}"

# Agent shells often skip the login profile, so the email lives in a file per repo.
EMAIL="${JIRA_EMAIL:-}"
if [[ -z "$EMAIL" && -r "$EMAIL_FILE" ]]; then EMAIL=$(tr -d ' \t\r\n' < "$EMAIL_FILE"); fi

# A custom priority field (e.g. a "Launch Priority" select) named in §4 Priority, if any.
# Requested explicitly because search otherwise returns null for every custom field.
PRIORITY_FIELD="${JIRA_PRIORITY_FIELD:-$(cfg jira-priority | grep -oE 'customfield_[0-9]+' | head -n1 || true)}"
SEARCH_FIELDS=$(jq -cn --arg p "$PRIORITY_FIELD" \
  '["key","summary","status","assignee","reporter","labels","priority","issuetype"] + (if $p == "" then [] else [$p] end)')

# jq helper: render any Jira field value as one short string.
JQ_VAL='def val: if . == null then "-"
  elif type == "array" then (if length == 0 then "-" else (map(val) | join(", ")) end)
  elif type == "object" then (.value // .name // .displayName // .accountId // tojson)
  else tostring end;'

die() { printf '%s\n' "$*" >&2; exit 1; }

have_token() { [[ -n "${JIRA_TOKEN:-}" || -r "$TOKEN_FILE" ]]; }

# A string for a double-quoted curl config value.
cfgq() { local v="${1//\\/\\\\}"; printf '%s' "${v//\"/\\\"}"; }

# curl with Basic auth. The credentials go to curl as a config on stdin (curl -K -), never on its
# argv, where any user could read them with ps; xtrace is paused while the token is in a variable,
# so `bash -x desk-jira ...` does not print it either.
curl_auth() {
  local xt=0 tok rc=0
  case $- in *x*) xt=1; set +x ;; esac
  if [[ -n "${JIRA_TOKEN:-}" ]]; then tok="$JIRA_TOKEN"; else tok=$(tr -d ' \t\r\n' < "$TOKEN_FILE"); fi
  printf 'user = "%s:%s"\n' "$(cfgq "$EMAIL")" "$(cfgq "$tok")" \
    | if (( LOCAL_HTTP )); then curl -sS --noproxy '*' -K - "$@"; else curl -sS -K - "$@"; fi || rc=$?
  tok=""
  if (( xt )); then set -x; fi
  return $rc
}

# Jira answers an anonymous request with 200 and an empty result, so "no issues" proves nothing
# until the credentials have been. One /myself call per invocation settles it.
AUTH_OK=0
ensure_auth() {
  (( AUTH_OK )) && return 0
  local code
  code=$(curl_auth -o /dev/null -w '%{http_code}' -H 'Accept: application/json' "$BASE/rest/api/3/myself") \
    || die "desk-jira: could not reach $BASE (see the curl error above)"
  case "$code" in
    2*) AUTH_OK=1 ;;
    401|403)
      local src="$TOKEN_FILE"; [[ -n "${JIRA_TOKEN:-}" ]] && src='$JIRA_TOKEN'
      die "desk-jira: authentication failed for $SITE as $EMAIL (HTTP $code). Check the token in $src." ;;
    *) die "desk-jira: the auth check against $SITE returned HTTP $code" ;;
  esac
}

# api <method> <path> [curl args...] — path is everything after /rest/
api() {
  local method="$1" path="$2"; shift 2
  local out code msgs
  out=$(curl_auth -w '\n%{http_code}' -X "$method" -H 'Accept: application/json' "$BASE/rest/$path" "$@") \
    || { printf 'desk-jira: could not reach %s (see the curl error above)\n' "$BASE" >&2; return 1; }
  code=$(printf '%s' "$out" | tail -n1)
  out=$(printf '%s' "$out" | sed '$d')
  if [[ "$code" =~ ^2 ]]; then printf '%s' "$out"; return 0; fi
  printf 'HTTP %s from %s %s\n' "$code" "$method" "$path" >&2
  # Print Jira's parsed messages; if there are none, print the raw body rather than nothing.
  # A bare "HTTP 400" with no reason makes a call like create look broken.
  msgs=$(printf '%s\n' "$out" | jq -r '(.errorMessages // [])[], (.errors // {} | to_entries[] | "\(.key): \(.value)")' 2>/dev/null || true)
  if [[ -n "$msgs" ]]; then printf '%s\n' "$msgs" >&2; else printf '%s\n' "${out:-(empty response body)}" >&2; fi
  return 1
}

realpath_of() {
  if command -v realpath >/dev/null 2>&1; then realpath "$1" 2>/dev/null
  else python3 -I -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; fi
}

# A file whose contents leave this machine (a body, a field=@file, an attachment) must be inside
# this repo's worktree, $DESK_STATE or a temp dir. Never under the desk config root (other repos'
# tokens live there), never inside a .git directory, never an .env file. Symlinks are resolved first.
check_outgoing_file() {
  local f="$1" real root top cfgroot
  real=$(realpath_of "$f") || die "desk-jira: cannot resolve $f"
  [[ -n "$real" ]] || die "desk-jira: cannot resolve $f"
  cfgroot=$(realpath_of "${DESK_CONFIG_ROOT:-$HOME/.config/desk}" || true)
  if [[ -n "$cfgroot" && ( "$real" == "$cfgroot" || "$real" == "$cfgroot"/* ) ]]; then
    die "desk-jira: refusing to send $f: it resolves under $cfgroot, where desk keeps per-repo credentials"
  fi
  case "/$real/" in
    */.git/*) die "desk-jira: refusing to send $f: it is inside a .git directory" ;;
  esac
  case "$(basename "$real")" in
    .env|.env.*) die "desk-jira: refusing to send $f: an .env file holds secrets" ;;
  esac
  top=$(git rev-parse --show-toplevel 2>/dev/null || true)
  for root in "$top" "${DESK_STATE:-}" "${TMPDIR:-}" /tmp; do
    [[ -n "$root" ]] || continue
    root=$(realpath_of "$root" || true)
    [[ -n "$root" ]] || continue
    [[ "$real" == "${root%/}"/* ]] && return 0
  done
  die "desk-jira: refusing to send $f ($real): a body, field=@file or attachment must be inside this repo's worktree (${top:-none here}), \$DESK_STATE or a temp dir (\$TMPDIR, /tmp)"
}

json() { api "$@" -H 'Content-Type: application/json'; }

FIELD_SCHEMA=''
field_type() {  # schema.type of a field id (option, user, array, string...), empty if unknown
  if [[ -z "$FIELD_SCHEMA" ]]; then FIELD_SCHEMA=$(api GET 'api/3/field') || return 1; fi
  printf '%s' "$FIELD_SCHEMA" | jq -r --arg k "$1" '.[] | select(.id == $k) | .schema.type // empty'
}

my_account_id() { api GET 'api/3/myself' | jq -r '.accountId'; }

# A list row of this repo's config, as a JSON array of its items; `none` and unset are [].
cfg_list() {
  [[ -n "$SLUG" && -r "$DESK_ENV_MJS" ]] || { printf '[]'; return 0; }
  { node "$DESK_ENV_MJS" list "$1" 2>/dev/null || true; } | jq -Rsc 'split("\n") | map(select(length > 0 and (ascii_downcase != "none")))'
}

# Field rules from config §4, checked before create or edit sends anything:
#   Required fields          one item per rule, `<Type>[, <Type>…]: <field>[, <field>…]`: what a type must carry
#   Size field               the size field: an XL is refused on every type but Epic, which is split instead
#   Priorities only you set  values of the §4 Priority field a headless autopilot worker may never set
#                            (spawn-worker.sh exports DESK_AUTOPILOT_WORKER), and an interactive session
#                            sets only with --approved, which is recorded on the ticket as a comment
RULES_LOADED=0 RULES_REQ='[]' RULES_TOP='[]' RULES_SIZE=''
load_rules() {
  (( RULES_LOADED )) && return 0
  RULES_REQ=$(cfg_list jira-required-fields)
  RULES_TOP=$(cfg_list jira-priority-user-only)
  RULES_SIZE=$(cfg jira-size-field | grep -oE 'customfield_[0-9]+' | head -n1 || true)
  RULES_LOADED=1
}
PRIORITY_KEY="${PRIORITY_FIELD:-priority}"

# rule_errors <create|edit> <issue type> <fields json> <approved text>: one refusal per line, none
# when the write may go. An option is read by name only: a bare name, or an object whose one key is
# "value" or "name". Any other object (an id, both keys, anything extra) is refused, because Jira
# may write a key the rules did not read: an id over a name, or a name over a value.
rule_errors() {
  load_rules
  jq -rn --arg mode "$1" --arg type "$2" --argjson f "$3" --arg approved "$4" \
    --argjson req "$RULES_REQ" --argjson top "$RULES_TOP" --arg size "$RULES_SIZE" \
    --arg pf "$PRIORITY_KEY" --arg headless "${DESK_AUTOPILOT_WORKER:-}" '
    def byname: type == "object" and (keys == ["value"] or keys == ["name"]);
    def blank: . == null or . == "" or . == [] or . == {} or (byname and ((.value // .name // "") == ""));
    def oname: if type == "string" then . elif byname then (.value // .name) else null end;
    def trim: gsub("^\\s+|\\s+$"; "");
    ($type | ascii_downcase) as $t
    | ([$req[] | capture("^(?<types>[^:]+):(?<fields>.+)$")?
        | select([.types | split(",")[] | trim | ascii_downcase] | index($t))
        | .fields | split("[,\\s]+"; null)[] | select(length > 0)] | unique) as $need
    | ($req[] | select(test("^[^:]+:.*[^\\s]") | not)
        | "desk-jira: config §4 Required fields item \"\(.)\" is not <Type>: <field>, so the rules cannot be checked"),
      ($need[] as $k
        | if $mode == "create" then
            (if ($f | has($k) | not) or ($f[$k] | blank)
             then "desk-jira: a \($type) needs \($k) (config §4 Required fields): add \($k)=<value>" else empty end)
          elif ($f | has($k)) and ($f[$k] | blank)
            then "desk-jira: refusing to clear \($k): a \($type) needs it (config §4 Required fields)"
          else empty end),
      (if $size != "" and ($f | has($size)) and ($f[$size] | blank | not) then
         ($f[$size] | oname) as $n
         | if $n == null then "desk-jira: pass \($size) by its option name (e.g. \($size)=L), not an id"
           elif ($n | ascii_upcase) == "XL" and $t != "epic"
             then "desk-jira: refusing \($size)=XL on a \($type): split it into tickets of L or smaller (only an Epic may be XL)"
           else empty end
       else empty end),
      ((($top | length) > 0 and ($f | has($pf)) and ($f[$pf] | blank | not)) as $sets
       | (if $sets then ($f[$pf] | oname) else null end) as $n
       | ($sets and $n != null and any($top[]; ascii_downcase == ($n | ascii_downcase))) as $topset
       | if $sets and $n == null then "desk-jira: pass \($pf) by its name (e.g. \($pf)=P2), not an id"
         elif $topset and $headless != "" then
           "desk-jira: refusing \($pf)=\($n): only the user sets it (config §4 Priorities only you set), and this is a headless autopilot worker. Set a lower value and park with the case for \($n); the user decides, and their decision is recorded on the ticket"
         elif $topset and $approved == "" then
           "desk-jira: refusing \($pf)=\($n): only the user sets it (config §4 Priorities only you set). Ask them, then pass --approved \"<their decision, in a sentence>\" and it is recorded on the ticket"
         elif $approved != "" and ($topset | not) then
           "desk-jira: --approved is only for setting a value in config §4 Priorities only you set, and this write sets none"
         else empty end)'
}

# After a write that set a priority under --approved: the user's decision goes on the ticket.
record_approval() {  # key fields-json approved
  local n who body
  n=$(printf '%s' "$2" | jq -r --arg pf "$PRIORITY_KEY" '.[$pf] | if type == "string" then . else (.value // .name) end')
  who=$(api GET 'api/3/myself' | jq -r '.displayName // .accountId') || who="the user"
  body=$(printf '%s set to %s by %s: %s\n(%s/desk-jira priority)' "$PRIORITY_KEY" "$n" "$who" "$3" "$1")
  json POST "api/2/issue/$1/comment" -d "$(jq -n --arg b "$body" '{body:$b}')" >/dev/null \
    || die "desk-jira: $1 now has $PRIORITY_KEY=$n, but recording the decision on the ticket failed: comment it by hand"
  echo "  recorded on $1: $PRIORITY_KEY=$n approved by $who"
}

# The approved text from a trailing --approved <text> or --approved=<text>, kept apart from the field
# pairs. Sets APPROVED and REST (the other arguments, one per line in an array).
APPROVED='' REST=()
split_approved() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --approved) [[ $# -ge 2 && -n "$2" ]] || die "desk-jira: --approved needs the user's decision as its value"
                  APPROVED="$2"; shift 2 ;;
      --approved=*) APPROVED="${1#--approved=}"; shift
                  [[ -n "$APPROVED" ]] || die "desk-jira: --approved needs the user's decision as its value" ;;
      *) REST+=("$1"); shift ;;
    esac
  done
  return 0
}

# Turn a key=value list into a fields object.
#   key=@path       the file's contents, as a string (a missing file is an error, never the literal)
#   key=<json>      kept as JSON, so '{"value":"P1"}', 266 and null pass straight through
#   key=<bare>      wrapped to the shape the field needs: assignee/reporter -> {"accountId"}
#                   ("me" resolves to your own account), priority/issuetype -> {"name"},
#                   a select custom field -> {"value"}, a user custom field -> {"accountId"}
fields_from_args() {
  local obj='{}' pair k v t w
  for pair in "$@"; do
    [[ "$pair" == *=* ]] || die "expected field=value, got: $pair"
    k="${pair%%=*}"; v="${pair#*=}"
    if [[ "$k" == parent ]]; then   # only a key: a file, a JSON number or object here is a mistake
      [[ "$v" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]] || die "desk-jira: parent must be an issue key (e.g. ABC-12), got: $v"
      obj=$(printf '%s' "$obj" | jq --arg v "$v" '.parent={key:$v}')
      continue
    fi
    if [[ "$v" == @* ]]; then
      [[ -f "${v#@}" ]] || die "desk-jira: file not found for $k: ${v#@}"
      check_outgoing_file "${v#@}"
      if [[ "$k" == description && "$v" == *.md ]]; then
        # The sentinel keeps the trailing newline that $(...) would strip.
        w=$(md_to_wiki < "${v#@}" && printf x) || die "desk-jira: could not convert ${v#@} to wiki markup"
        obj=$(printf '%s' "$obj" | jq --arg k "$k" --arg v "${w%x}" '.[$k]=$v')
      else
        obj=$(printf '%s' "$obj" | jq --arg k "$k" --rawfile v "${v#@}" '.[$k]=$v')
      fi
      continue
    fi
    if [[ -n "$v" ]] && printf '%s' "$v" | jq . >/dev/null 2>&1; then
      obj=$(printf '%s' "$obj" | jq --arg k "$k" --argjson v "$v" '.[$k]=$v')
      continue
    fi
    case "$k" in
      assignee|reporter)
        [[ "$v" == me ]] && v=$(my_account_id)
        obj=$(printf '%s' "$obj" | jq --arg k "$k" --arg v "$v" '.[$k]={accountId:$v}') ;;
      priority|issuetype)
        obj=$(printf '%s' "$obj" | jq --arg k "$k" --arg v "$v" '.[$k]={name:$v}') ;;
      customfield_*)
        t=$(field_type "$k" 2>/dev/null || true)
        case "$t" in
          option) obj=$(printf '%s' "$obj" | jq --arg k "$k" --arg v "$v" '.[$k]={value:$v}') ;;
          user)   obj=$(printf '%s' "$obj" | jq --arg k "$k" --arg v "$v" '.[$k]={accountId:$v}') ;;
          *)      obj=$(printf '%s' "$obj" | jq --arg k "$k" --arg v "$v" '.[$k]=$v') ;;
        esac ;;
      *)
        obj=$(printf '%s' "$obj" | jq --arg k "$k" --arg v "$v" '.[$k]=$v') ;;
    esac
  done
  printf '%s' "$obj"
}

body_of() {  # file path (optionally @path), or the literal string
  if [[ -f "$1" ]]; then check_outgoing_file "$1"; cat "$1"; return; fi
  if [[ "$1" == @* && -f "${1#@}" ]]; then check_outgoing_file "${1#@}"; cat "${1#@}"; return; fi
  # Without this, a mistyped invocation posts the mistake as the body:
  # `comment KEY-1 --file b.txt` would set the comment to the literal "--file".
  case "$1" in
    --*)  echo "desk-jira: '$1' looks like a flag - the body is positional: <body-file|text>" >&2; return 2 ;;
    @*|*.md|*.txt|*.json|*.adf|*.wiki)
          echo "desk-jira: file not found: ${1#@}" >&2; return 2 ;;
  esac
  printf '%s' "$1"
}

# A markdown body on stdin -> Jira wiki markup on stdout; a body that is not markdown comes back
# byte for byte. API v2 reads wiki markup, where `## Summary` is a nested numbered list and
# backticks print literally. The converter is ported from Sophos-Education/studia-skills#13 and
# embedded because install.sh installs this one file.
#
# Which bodies convert: no wiki-only construct (an h2. heading, a {code} or {noformat} block, bq.,
# a || table header, a [text|url] link), and at least one markdown-only one (a fence, a backtick
# span, **bold**, [text](url), a numbered `1.` item, a `|---|` table rule, or a `#` heading standing
# on its own after a blank line). `- ` items count only when there is no {{monospace}} or run of `#`
# list lines, which wiki markup also writes. So a .md file of wiki markup, as the skills wrote until
# DS-31, still goes as is. Once converting, a line starting `#` and a space is a heading.
md_to_wiki() {
  command -v python3 >/dev/null 2>&1 || die "desk-jira: python3 is needed to convert a .md body (send it as a .wiki or .txt file to post it unchanged)"
  local py
  IFS= read -r -d '' py <<'PY' || true
import re, sys

# Inside {{...}} the renderer still parses effects, so every effect character is escaped there.
CODE_SPECIAL = re.compile(r'([{}\[\]*_+^~|!#-])')
# Fence languages Jira's {code} macro knows; anything else goes as {noformat}.
LANGS = {'bash': 'bash', 'sh': 'bash', 'shell': 'bash', 'zsh': 'bash', 'console': 'bash',
         'c': 'c', 'cpp': 'cpp', 'c++': 'cpp', 'csharp': 'c#', 'cs': 'c#', 'css': 'css',
         'go': 'go', 'html': 'html', 'java': 'java', 'javascript': 'javascript', 'js': 'javascript',
         'jsx': 'javascript', 'json': 'json', 'php': 'php', 'python': 'python', 'py': 'python',
         'ruby': 'ruby', 'rb': 'ruby', 'sql': 'sql', 'swift': 'swift', 'xml': 'xml',
         'yaml': 'yaml', 'yml': 'yaml'}
URL_IN_PARENS = r'(?:[^()\s]|\([^()\s]*\))+'   # a link target, balanced parentheses allowed
INLINE = re.compile(
    r'``\s?(?P<c2>.+?)\s?``'
    r'|`(?P<c1>[^`]+)`'
    r'|!\[(?P<it>[^\]]*)\]\((?P<iu>' + URL_IN_PARENS + r')(?:\s+"[^"]*")?\)'
    r'|\[(?P<lt>[^\]]+)\]\((?P<lu>' + URL_IN_PARENS + r')(?:\s+"[^"]*")?\)'
    r'|<(?P<au>https?://[^>\s]+)>'
    r'|(?P<url>https?://[^\s<>()\[\]|`]*[^\s<>()\[\]|`.,;:!?\'"])'
    r'|\*\*\*(?P<bi>[^*]+?)\*\*\*'
    r'|\*\*(?P<b1>[^*]+?)\*\*'
    r'|(?<![\w_])__(?P<b2>[^_]+?)__(?![\w_])'
    r'|(?<![\w*\\])\*(?P<i1>[^*\s](?:[^*]*?[^*\s])?)\*(?![\w*])'
    r'|(?<![\w_\\])_(?P<i2>[^_\s](?:[^_]*?[^_\s])?)_(?![\w_])'
    r'|~~(?P<s>[^~]+?)~~')
BS = '\x02'      # a literal backslash, sent as an entity
LP = '\x03'      # the ( of an emoticon, sent as \(
SMILE = '\x04'   # the : or ; of a smiley, sent with a backslash before it
ZWSP = '\u200b'
WORD = re.compile(r'\w')
# Jira turns these into icons, in code spans too: (x) (i) (on) ... and :) :( :P :D ;)
EMOTICON = re.compile(r'\((?=(?:x|n|y|i|/|!|\?|on|off|\*[rgby]?|\+|-|flag|flagoff|in|ok|sad)\))', re.I)
SMILEY = re.compile(r'([:;])(?=[()PD](?!\w))')
# A markdown backslash escape (\ + ASCII punctuation) stands for the character itself. It is held as
# a private-use character while the inline markers are matched, so \* or \` start nothing.
# Code spans come first and are left alone: a backslash inside one is literal (`C:\`).
MD_ESC = re.compile(r'(`+)[^`].*?(?<!`)\1(?!`)|\\([!-/:-@\[-`{-~])')
HELD = 0xE000
# Of those characters, the ones wiki markup needs escaped as text, and what each one becomes.
WIKI_LITERAL = {c: '\\' + c for c in '{}[]|*_+^~-!(?#'}
WIKI_LITERAL['\\'] = '&#92;'


def hold(s):
    return MD_ESC.sub(lambda m: m.group(0) if m.group(1) else chr(HELD + ord(m.group(2))), s)


def unhold_raw(s):
    # Back to the source text, for code spans and link targets, where markdown escapes do not apply.
    return re.sub('[\ue000-\ue07f]', lambda m: '\\' + chr(ord(m.group(0)) - HELD), s)


def emoticons(s):
    return SMILEY.sub(SMILE + r'\1', EMOTICON.sub(LP, s))


def unmark(s):
    return s.replace(LP, '\\(').replace(SMILE, '\\').replace(BS, '&#92;')


def esc_code(s):
    # A backslash before punctuation or at the end would escape what follows (and two make a line
    # break), so it goes as an entity. So does a brace at either end: the renderer pairs the braces
    # of {{\{ and \}}} wrongly and drops the code span.
    s = re.sub(r'\\(?=[^A-Za-z0-9\s]|$)', BS, s)
    s = emoticons(s)
    s = CODE_SPECIAL.sub(r'\\\1', s)
    if s.startswith('\\{'):
        s = '&#123;' + s[2:]
    if s.endswith('\\}'):
        s = s[:-2] + '&#125;'
    return unmark(s)


def esc_plain(s):
    s = s.replace('\\', BS)  # a backslash left after markdown escapes is literal
    s = emoticons(s)
    s = re.sub(r'([{}\[\]|])', r'\\\1', s)
    # A * _ + ^ ~ touching a word on one side only could pair up into an effect.
    s = re.sub(r'(?<![\w\\])([*_+^~])(?=\w)', r'\\\1', s)
    s = re.sub(r'(?<=\w)([*_+^~])(?!\w)', r'\\\1', s)
    s = re.sub(r'(?<![\w\\-])-(?=\w)', r'\\-', s)
    s = s.replace('--', r'\-\-')
    s = re.sub('[\ue000-\ue07f]', lambda m: WIKI_LITERAL.get(chr(ord(m.group(0)) - HELD), chr(ord(m.group(0)) - HELD)), s)
    return unmark(s)


def inline(s):
    return inline_held(hold(s))


def inline_held(s):
    out, i = [], 0
    for m in INLINE.finditer(s):
        out.append(esc_plain(s[i:m.start()]))
        g = m.groupdict()
        code = g['c2'] if g['c2'] is not None else g['c1']
        if g['iu'] is not None:
            # an image becomes a plain link: an embedded one would need the file attached
            alt = inline_held(g['it'])
            out.append('[' + (alt + '|' if alt else '') + unhold_raw(g['iu']) + ']')
        elif g['lt'] is not None:
            out.append('[' + inline_held(g['lt']) + '|' + unhold_raw(g['lu']) + ']')
        elif g['au'] is not None:
            out.append('[' + unhold_raw(g['au']) + ']')
        elif g['url'] is not None:
            out.append(unhold_raw(g['url']))
        else:
            if code is not None:
                tok = '{{' + esc_code(unhold_raw(code).strip()) + '}}'
            elif g['bi'] is not None:
                tok = '*_' + inline_held(g['bi']) + '_*'
            elif g['b1'] is not None or g['b2'] is not None:
                tok = '*' + inline_held(g['b1'] if g['b1'] is not None else g['b2']) + '*'
            elif g['i1'] is not None or g['i2'] is not None:
                tok = '_' + inline_held(g['i1'] if g['i1'] is not None else g['i2']) + '_'
            else:
                tok = '-' + inline_held(g['s']) + '-'
            # An effect touching a letter (`<dc-import>`ed) is not parsed as one; a zero-width
            # space between them lets it render.
            if m.start() > 0 and WORD.match(s[m.start() - 1]):
                tok = ZWSP + tok
            if m.end() < len(s) and WORD.match(s[m.end()]):
                tok += ZWSP
            out.append(tok)
        i = m.end()
    out.append(esc_plain(s[i:]))
    return ''.join(out)


def cell(c):
    # A <br> in a table cell is a line break inside the cell.
    return ' \\\\ '.join(inline(p.strip()) for p in re.split(r'(?i)<br\s*/?>', c)) or ' '


def cells(row):
    # Split a pipe row on | that is outside backticks and not escaped as \|.
    row = row.strip()
    if row.startswith('|'):
        row = row[1:]
    if row.endswith('|') and not row.endswith('\\|'):
        row = row[:-1]
    out, cur, tick, i = [], '', False, 0
    while i < len(row):
        ch = row[i]
        if ch == '\\' and i + 1 < len(row) and row[i + 1] == '|':
            cur += '|'; i += 2; continue
        if ch == '`':
            tick = not tick
        if ch == '|' and not tick:
            out.append(cur.strip()); cur = ''
        else:
            cur += ch
        i += 1
    out.append(cur.strip())
    return out


def code_block(body, lang):
    # {noformat} and {code} end at the first closing tag, even one inside the block, so pick a macro
    # the body does not contain. A backslash inside the block prints literally, so when the body has
    # both, a zero-width space breaks up each {noformat} in it.
    text = '\n'.join(body)
    has_nf, has_code = '{noformat}' in text, '{code' in text
    if lang in LANGS and not has_code:
        return ['{code:' + LANGS[lang] + '}'] + body + ['{code}']
    if not has_nf:
        return ['{noformat}'] + body + ['{noformat}']
    if not has_code:
        return ['{code:none}'] + body + ['{code}']
    return ['{noformat}'] + [l.replace('{noformat}', '{' + ZWSP + 'noformat}') for l in body] + ['{noformat}']


FENCE = re.compile(r'^(\s*)(`{3,}|~{3,})\s*([^\s`]*)')
HEADING = re.compile(r'^\s{0,3}(#{1,6})\s+(.*?)(?:\s+#+)?\s*$')
HR = re.compile(r'^\s{0,3}([-*_])(?:\s*\1){2,}\s*$')
ITEM = re.compile(r'^(\s*)(\d+[.)]|[*+-])\s+(.*)$')
SEP = re.compile(r'^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$')
QUOTE = re.compile(r'^\s{0,3}>\s?(.*)$')
MACRO_END = ('{noformat}', '{code}')

def indent_of(line):
    return len(re.match(r'^[ \t]*', line).group(0).replace('\t', '    '))


def convert(md):
    lines = md.replace('\r\n', '\n').replace('\r', '\n').split('\n')
    out = []
    stack = []      # open list levels: (indent, '#' or '*')
    block = None    # [prefix, raw text] of the paragraph or list item being collected
    n, i = len(lines), 0

    def flush():
        nonlocal block
        if block is not None:
            out.append(block[0] + inline(block[1]))
            block = None

    def next_nonblank(j):
        while j < n and not lines[j].strip():
            j += 1
        return lines[j] if j < n else None

    def in_item(l):
        # indented under the open list, so it belongs to the last item
        return bool(stack) and indent_of(l) > stack[0][0]

    while i < n:
        line = lines[i]
        st = line.strip()

        m = FENCE.match(line)
        if m:
            flush()
            if not in_item(line):
                stack = []
            # Inside a list the block follows its item's line directly, which keeps the list (and
            # its numbering) going.
            fence, ind, lang = m.group(2), len(m.group(1)), m.group(3).lower()
            close = re.compile(r'^\s*' + re.escape(fence[0]) + '{' + str(len(fence)) + r',}\s*$')
            body, j = [], i + 1
            while j < n and not close.match(lines[j]):
                body.append(re.sub(r'^ {0,%d}' % ind, '', lines[j])); j += 1
            out.extend(code_block(body, lang))
            i = j + 1
            continue

        if not st:
            flush()
            nxt = next_nonblank(i + 1)
            if stack and nxt is not None:
                if ITEM.match(nxt) and not HR.match(nxt):
                    i += 1; continue           # a loose list stays one list
                if FENCE.match(nxt) and in_item(nxt):
                    i += 1; continue           # a code block inside an item
                if in_item(nxt) and out and out[-1] not in MACRO_END:
                    # a further paragraph inside the item: a line break in the same item
                    j = i + 1
                    while not lines[j].strip():
                        j += 1
                    out[-1] += ' \\\\ ' + inline(lines[j].strip())
                    i = j + 1
                    continue
            stack = []
            if out and out[-1] != '':
                out.append('')
            i += 1
            continue

        m = HEADING.match(line)
        if m:
            flush(); stack = []
            out.append('h%d. ' % len(m.group(1)) + inline(m.group(2)))
            i += 1; continue

        if HR.match(line):
            flush(); stack = []
            out.append('----')
            i += 1; continue

        if '|' in st and i + 1 < n and SEP.match(lines[i + 1]):
            flush(); stack = []
            out.append('||' + '||'.join(cell(c) for c in cells(line)) + '||')
            i += 2
            while i < n and lines[i].strip() and '|' in lines[i]:
                out.append('|' + '|'.join(cell(c) for c in cells(lines[i])) + '|')
                i += 1
            continue

        if st.startswith('|') and st.endswith('|') and len(st) > 1 and block is None:
            # already a wiki table row: convert the markdown inside each cell
            stack = []
            if st.startswith('||'):
                out.append('||' + '||'.join(cell(c.strip()) for c in st[2:-2].split('||')) + '||')
            else:
                out.append('|' + '|'.join(cell(c.strip()) for c in st[1:-1].split('|')) + '|')
            i += 1; continue

        m = QUOTE.match(line)
        if m and not stack:
            flush()
            paras, cur = [], []
            while i < n and QUOTE.match(lines[i]):
                t = QUOTE.match(lines[i]).group(1).strip()
                if t:
                    cur.append(t)
                elif cur:
                    paras.append(' '.join(cur)); cur = []
                i += 1
            if cur:
                paras.append(' '.join(cur))
            if len(paras) == 1:
                out.append('bq. ' + inline(paras[0]))
            elif paras:
                out.append('{quote}'); out.append('\n\n'.join(inline(p) for p in paras)); out.append('{quote}')
            continue

        m = ITEM.match(line)
        if m:
            flush()
            ind = indent_of(m.group(1))
            mark = '#' if m.group(2)[0].isdigit() else '*'
            while stack and stack[-1][0] > ind:
                stack.pop()
            if stack and stack[-1][0] == ind:
                if len(stack) == 1 and stack[0][1] != mark:
                    out.append('')     # a different top-level list: keep them apart
                stack[-1] = (ind, mark)
            else:
                stack.append((ind, mark))
            block = [''.join(k for _, k in stack) + ' ', m.group(3).strip()]
            i += 1; continue

        if block is not None:
            # a soft-wrapped line (or lazy continuation of a list item): one line in wiki markup
            block[1] += ' ' + st
            i += 1; continue

        if in_item(line) and out and out[-1] not in MACRO_END:
            out[-1] += ' ' + inline(st)
            i += 1; continue

        stack = []
        block = ['', st]
        i += 1

    flush()
    while out and out[-1] == '':
        out.pop()
    return '\n'.join(out) + '\n'


WIKI_BLOCK = re.compile(r'^\s*(?:h[1-6]\.\s|bq\.\s|\|\||\{(?:code|noformat|quote|panel)[:}])')
WIKI_LINK = re.compile(r'\[[^\]\n|]*\|(?:https?://|mailto:)[^\]\s]*\]')
CODE_SPAN = re.compile(r'`[^`\n]+`')
MD_SURE = re.compile(r'`[^`\n]+`|\*\*[^*\s](?:[^*\n]*[^*\s])?\*\*|\]\([^)\s]+\)|^\s*\d+[.)]\s+\S|^\s*\|?\s*:?-{3,}:?\s*\|')
MD_DASH = re.compile(r'^\s*[-+]\s+\S')
HASH_LINE = re.compile(r'^\s{0,3}#{1,6}\s+\S')


def is_markdown(md):
    lines = md.replace('\r\n', '\n').replace('\r', '\n').split('\n')
    sure = dash = wikiish = False
    fence = None
    for idx, line in enumerate(lines):
        m = FENCE.match(line)
        if fence is not None:
            # what a fence holds is code, so nothing in it says which markup the body is
            if m and m.group(2)[0] == fence[0] and len(m.group(2)) >= len(fence) and not m.group(3):
                fence = None
            continue
        if m:
            fence, sure = m.group(2), True
            continue
        bare = CODE_SPAN.sub('', line)
        if WIKI_BLOCK.match(line) or WIKI_LINK.search(bare):
            return False
        if MD_SURE.search(line):
            sure = True
        if MD_DASH.match(line):
            dash = True
        if '{{' in bare:
            wikiish = True
        if HASH_LINE.match(line):
            prev = lines[idx - 1].strip() if idx else ''
            nxt = lines[idx + 1].strip() if idx + 1 < len(lines) else ''
            # A wiki list item follows text or another item; a heading stands after a blank line.
            if not prev and not nxt.startswith('#'):
                sure = True
            else:
                wikiish = True
    return sure or (dash and not wikiish)


def main():
    raw = sys.stdin.buffer.read()
    data = raw.decode('utf-8', 'replace')
    if is_markdown(data):
        sys.stdout.buffer.write(convert(data).encode('utf-8'))
    else:
        sys.stdout.buffer.write(raw)
    sys.stdout.buffer.flush()


main()
PY
  # -I (isolated): no current directory or script directory on sys.path, no PYTHON* variables and no
  # user site-packages, so a re.py where desk-jira is run cannot execute with the Jira token in the
  # environment. The converter needs only the standard library.
  python3 -I -c "$py"
}

# body_of, converted from markdown when the source is a .md file; anything else goes byte for byte.
# Callers append a sentinel inside $(...) and strip it, so trailing newlines survive too.
text_of() {
  case "$1" in
    *.md) [[ -f "${1#@}" ]] || { body_of "$1"; return; }   # (and @*.md) a missing file: body_of says so
          body_of "$1" | md_to_wiki ;;
    *)    body_of "$1" ;;
  esac
}

# A description carries no Status, Priority, P0-P4 or Size line: those live in fields, and a copy in
# the body goes stale the day the field moves. The one exception is the Size fallback, `Size: <X>`
# as the first line, for a project whose config names no §4 Size field. One refusal per line.
FACT_LEAD='^[[:space:]]*(([*#>|+-]|h[1-6]\.|bq\.)[[:space:]]*)*[*_]*'
desc_errors() {  # description text
  load_rules
  local first hits hit n text
  first=$(printf '%s\n' "$1" | grep -n '[^[:space:]]' | head -n1 | cut -d: -f1) || true
  hits=$(printf '%s\n' "$1" | grep -inE "${FACT_LEAD}"'((status|([a-z]+ )?priority|size)[*_]*[[:space:]]*[:=]|p[0-4][*_]*[[:space:]]*($|[:=]|[\\]?-))') || return 0
  while IFS= read -r hit; do
    n="${hit%%:*}"; text="${hit#*:}"
    if [[ "$n" == "$first" && -z "$RULES_SIZE" ]] \
      && printf '%s' "$text" | grep -qiE "${FACT_LEAD}"'size[*_]*[[:space:]]*[:=]'; then continue; fi
    printf 'desk-jira: refusing line %s of the description, "%s": status, priority and size live in their fields, never in the body (the one exception is a first line `Size: <X>` where config names no §4 Size field)\n' "$n" "$text"
  done <<<"$hits"
}

usage() {
  cat <<'EOF'
desk-jira <command> [args]

  where [--dir]                   which repo, site, project, email and token it resolved
  whoami                          confirm auth
  search <jql> [max] [--json]     key / status / priority (§4 Priority field if set) / summary
  get <KEY> [--json]              the whole issue: parent, custom fields in full, links, subtasks,
                                  attachments, web links, description with wiki escapes removed
                                  (--json: the raw issue)
  children <KEY> [--json]         an epic's children or a story's subtasks, in rank order (paged)
  fields [filter]                 field ids and names (find custom fields)
  meta [issuetype]                createmeta: required fields + allowed values

  create <type> <summary> <desc-file|text> [field=value ...] [--route] [--approved <text>]
                                  assigned to you when §3 jira-assign-self is yes and no assignee
                                  is given; anyone else needs --route; the assignee is read back
  edit <KEY> <field=value ...> [--approved <text>]
                                  prints each field read back from Jira after the write
  labels <KEY> add|remove <label ...>
  link <KEY> blocked-by|blocks <OTHER>   a Blocks link, direction handled, read back

  comment <KEY> <body-file|text>
  comments <KEY>                  existing comments (check idempotency markers)

  transitions <KEY>               available transitions, with ids
  transition <KEY> <name-or-id>   exact or case-insensitive name match

  attach <KEY> <file ...>

  api <path>                      read-only GET of /rest/<path>, raw JSON (e.g. api/3/myself)
  md2wiki <file|->                print the body a file is sent as (no credentials; - is a .md on stdin)

Bodies:        a .md file (create's description, comment, edit description=@file.md) is converted
               from markdown to Jira wiki markup, unless it is already wiki markup; any other file
               (.wiki, .txt) and literal text go unchanged. Once converting, "# " starts a heading,
               so text from get or comments (wiki markup) goes back as .wiki. A description with a
               Status, Priority, P0-P4 or Size line is refused: those are fields (only a first line
               "Size: <X>" passes, where config names no §4 Size field)
Field values:  field=@file reads a file · JSON passes through · a bare value is wrapped
               (customfield_12345=P1 -> {"value":"P1"}, assignee=me -> your accountId)
               parent=ABC-12 files the new issue under that epic or story

Field rules:   config §4, checked before create or edit sends anything. A create missing a §4
               Required fields field for its type is refused, and so is an edit clearing one. §4 Size
               field XL is refused on all but an Epic: split it. A §4 Priorities only you set value
               needs --approved "<the user's decision>", posted to the ticket as a comment, and is
               always refused to a headless autopilot worker

Config:        this repo's ~/.config/desk/repos/<slug>/ (see `desk-jira where`)
Env overrides: JIRA_SITE JIRA_EMAIL JIRA_EMAIL_FILE JIRA_PROJECT JIRA_TOKEN JIRA_TOKEN_FILE
               JIRA_PRIORITY_FIELD; the repo itself as desk-env resolves it (DESK_REPO_OVERRIDE,
               DESK_CONFIG, DESK_CONFIG_ROOT)
Files sent:    a body, field=@file or attachment must be inside this repo, $DESK_STATE or a temp dir
EOF
}

cmd="${1:-}"; [[ -n "$cmd" ]] || { usage; exit 1; }
shift || true
command -v jq >/dev/null || die "jq is required"
command -v curl >/dev/null || die "curl is required"

# Fail loudly here rather than inside a subshell, where an exit would be swallowed
# and the call would go out unauthenticated and come back 401.
case "$cmd" in
  -h|--help|help|where|md2wiki) ;;
  *) [[ -n "$SLUG" || -n "${JIRA_SITE:-}" ]] || die "not inside a git repo, so there is no repo to take the Jira site from (run it inside the repo, or set JIRA_SITE and JIRA_PROJECT)"
     if [[ -z "$SITE" ]]; then
       [[ "$(first_word_raw "$(cfg tracker)")" == none ]] && die "Tracker is none for $SLUG: this repo has no Jira (config §4 Tracker in $CONFIG_PATH)"
       die "no Jira site for ${SLUG:-this repo}: set §4 Jira site in ${CONFIG_PATH:-the repo config} (/desk-setup), or JIRA_SITE"
     fi
     [[ -n "$EMAIL" ]] || die "no email for ${SLUG:-this repo}: write it to $EMAIL_FILE (or set JIRA_EMAIL) - see the setup notes at the top of this script"
     have_token || die "no token for ${SLUG:-this repo}: create $TOKEN_FILE (chmod 600) or set JIRA_TOKEN" ;;
esac

case "$cmd" in
  where)
    if [[ "${1:-}" == --dir ]]; then [[ -n "$SLUG" ]] || die "not inside a git repo"; printf '%s\n' "$REPO_DIR"; exit 0; fi
    echo "repo    : ${SLUG:-(not in a git repo)}"
    echo "config  : ${CONFIG_PATH:-(none)}"
    if [[ -n "$SITE" ]]; then echo "site    : $SITE"
    elif [[ -n "$SLUG" && "$(first_word_raw "$(cfg tracker)")" == none ]]; then echo "site    : (Tracker is none for $SLUG)"
    else echo "site    : (unset)"; fi
    echo "project : ${PROJECT:-(unset: create needs it)}"
    echo "email   : ${EMAIL:-(unset)}  <- $EMAIL_FILE"
    if [[ -n "${JIRA_TOKEN:-}" ]]; then echo "token   : from JIRA_TOKEN"
    elif [[ -r "$TOKEN_FILE" ]]; then echo "token   : $TOKEN_FILE"
    else echo "token   : (missing) $TOKEN_FILE"; fi
    echo "priority: ${PRIORITY_FIELD:-built-in priority}"
    ;;

  whoami)
    ensure_auth
    api GET 'api/3/myself' | jq -r '"\(.displayName) <\(.emailAddress)>  accountId=\(.accountId)"'
    ;;

  search)
    [[ $# -ge 1 ]] || die 'usage: desk-jira search <jql> [max] [--json]'
    jql="$1"; shift
    max=50; raw=0
    for a in "$@"; do
      case "$a" in --json) raw=1 ;; *[0-9]*) max="$a" ;; esac
    done
    ensure_auth   # an empty result means "no issues" only once the credentials are proven
    payload=$(jq -n --arg jql "$jql" --argjson max "$max" --argjson f "$SEARCH_FIELDS" \
      '{jql:$jql, maxResults:$max, fields:$f}')
    res=$(json POST 'api/3/search/jql' -d "$payload")
    if (( raw )); then printf '%s\n' "$res"; else
      printf '%s' "$res" | jq -r --arg pf "$PRIORITY_FIELD" "$JQ_VAL"'
        if (.issues | length) == 0 then "no issues"
        else (.issues[] | "\(.key)\t\(.fields.status.name)\t\((if $pf != "" then .fields[$pf] else null end) // .fields.priority | val)\t\(.fields.summary)") end'
      if [[ "$(printf '%s' "$res" | jq -r '.nextPageToken // empty')" != "" ]]; then
        echo "(more results: raise max)" >&2
      fi
    fi
    ;;

  get)
    [[ $# -ge 1 ]] || die 'usage: desk-jira get <KEY> [--json]'
    key="$1"; shift
    ensure_auth   # anonymous gets a 404 that reads like a missing issue
    res=$(api GET "api/2/issue/$key?expand=names")
    if [[ "${1:-}" == '--json' ]]; then printf '%s\n' "$res"; else
      # Web links are not issue fields: they have their own endpoint. An unreadable list says so
      # rather than reading as "none".
      remote=$(api GET "api/2/issue/$key/remotelink") || remote='null'
      # The text form is for reading and copying, so wiki-markup escapes are dropped (`\-` prints as
      # `-`) everywhere but {code} and {noformat} blocks, whose text Jira keeps literally, and no
      # field is cut short. --json above stays the raw issue.
      printf '%s\n%s' "$res" "$remote" | jq -rs "$JQ_VAL"'
        def unwiki: if type == "string" then
            [scan("(?s)\\{(?:code|noformat)[^}]*\\}.*?\\{(?:code|noformat)\\}|(?:(?!\\{(?:code|noformat)).)+|.")]
            | map(if test("^\\{(code|noformat)") then . else gsub("\\\\(?<c>[-_*+^~?#{}\\[\\]|!])"; .c) end) | join("")
          else . end;
        def brief: "\(.key) (\(.fields.issuetype.name // "-"), \(.fields.status.name // "-")) \(.fields.summary // "")";
        def section($name; $rows): if ($rows | length) == 0 then "\($name): none" else "\($name):", ($rows[] | "  \(.)") end;
        .[0] as $i | .[1] as $remote | $i.fields as $f |
        "key      : \($i.key)",
        "type     : \($f.issuetype.name)",
        "parent   : \(if $f.parent then "\($f.parent.key) (\($f.parent.fields.issuetype.name // "-")) \($f.parent.fields.summary // "")" else "-" end)",
        "status   : \($f.status.name)",
        "summary  : \($f.summary)",
        "assignee : \($f.assignee | val)",
        "reporter : \($f.reporter | val)",
        "labels   : \($f.labels | val)",
        "priority : \($f.priority | val)",
        ($i.names as $n | $f | to_entries[]
          | select((.key | startswith("customfield_")) and .value != null and .value != [])
          | "\($n[.key] // .key) : \(.value | unwiki | val | gsub("\n"; " "))"),
        "",
        section("links"; [($f.issuelinks // [])[]
          | if .inwardIssue then "\(.type.inward // .type.name) \(.inwardIssue | brief)"
            else "\(.type.outward // .type.name) \(.outwardIssue | brief)" end]),
        section("subtasks"; [($f.subtasks // [])[] | brief]),
        section("attachments"; [($f.attachment // [])[]
          | "\(.filename) (\(.mimeType // "-"), \(.size // "?") bytes) \(.content // "")"]),
        (if $remote == null then "web links: (could not read them)"
         else section("web links"; [$remote[]
          | "\(.object.title // .object.url) \(.object.url)\(if .relationship then " (\(.relationship))" else "" end)"]) end),
        "",
        ($f.description // "(no description)" | unwiki)'
    fi
    ;;

  children)
    [[ $# -ge 1 ]] || die 'usage: desk-jira children <KEY> [--json]'
    key="$1"; shift
    [[ "$key" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]] || die "desk-jira: not an issue key: $key"
    ensure_auth   # an anonymous search returns 200 and no issues, which would read as "no children"
    # `parent =` is an epic's children and a story's subtasks alike (team- and company-managed).
    # Paged to the end: a batch built from a truncated list silently drops work. So a page that is
    # not the last but has no token, a token Jira already sent, or more than 200 pages is an error,
    # never a short list or an endless loop.
    all='[]'; token=''; seen=''; pages=0
    while :; do
      (( pages < 200 )) || die "desk-jira: children of $key: no last page after $pages pages; refusing a list that may be truncated"
      payload=$(jq -n --arg jql "parent = $key ORDER BY rank ASC" --arg t "$token" \
        '{jql:$jql, maxResults:100, fields:["summary","status","issuetype","assignee","issuelinks"]}
         + (if $t == "" then {} else {nextPageToken:$t} end)')
      res=$(json POST 'api/3/search/jql' -d "$payload") || exit 1
      pages=$((pages + 1))
      # On stdin, never argv: a page of real issues passes Linux's 128 KB cap on one argument.
      all=$(printf '%s\n%s' "$all" "$res" | jq -cs '.[0] + (.[1].issues // [])')
      [[ "$(printf '%s' "$res" | jq -r '.isLast == true')" == true ]] && break
      token=$(printf '%s' "$res" | jq -r '.nextPageToken // ""')
      [[ -n "$token" ]] || die "desk-jira: children of $key: page $pages is not the last but has no nextPageToken; refusing a partial list"
      ! grep -qxF -- "$token" <<<"$seen" || die "desk-jira: children of $key: page $pages repeats page token '$token'; stopping rather than looping"
      seen+="$token"$'\n'
    done
    if [[ "${1:-}" == '--json' ]]; then printf '%s\n' "$all"
    else
      printf '%s' "$all" | jq -r "$JQ_VAL"'
        if length == 0 then "no children"
        else .[] | "\(.key)\t\(.fields.issuetype.name // "-")\t\(.fields.status.name // "-")\t\(.fields.status.statusCategory.key // "-")\t\(.fields.assignee | val)\t\(.fields.summary // "")" end'
    fi
    ;;

  link)
    [[ $# -eq 3 ]] || die 'usage: desk-jira link <KEY> blocked-by|blocks <OTHER>'
    key="$1"; verb="$2"; other="$3"
    for k in "$key" "$other"; do [[ "$k" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]] || die "desk-jira: not an issue key: $k"; done
    [[ "$key" != "$other" ]] || die "desk-jira: an issue cannot block itself ($key)"
    # Jira's inwardIssue is the one that performs the outward verb ("inward blocks outward"), the
    # reverse of what the field names suggest; a link posted the obvious way lands backwards and
    # still returns 201. So the direction is decided here, once.
    case "$verb" in
      blocked-by) blocker="$other"; blocked="$key" ;;
      blocks)     blocker="$key";   blocked="$other" ;;
      *) die "desk-jira: the verb is blocked-by or blocks, not '$verb'" ;;
    esac
    ensure_auth
    # From the blocked issue's side, "blocked by X" is a Blocks entry whose inwardIssue is X, and
    # "blocks X" one whose outwardIssue is X.
    links_of() { api GET "api/2/issue/$1?fields=issuelinks" | jq -c '[.fields.issuelinks[]? | select(.type.name == "Blocks")
      | if .inwardIssue then {rel:"blocked-by", key:.inwardIssue.key} else {rel:"blocks", key:.outwardIssue.key} end]'; }
    have=$(links_of "$blocked") || exit 1
    if printf '%s' "$have" | jq -e --arg o "$blocker" 'any(.[]; .rel == "blocked-by" and .key == $o)' >/dev/null; then
      echo "already linked: $blocked is blocked by $blocker"; exit 0
    fi
    if printf '%s' "$have" | jq -e --arg o "$blocker" 'any(.[]; .rel == "blocks" and .key == $o)' >/dev/null; then
      die "desk-jira: refusing: $blocked already blocks $blocker, so this link would be the reverse of it and make a cycle"
    fi
    payload=$(jq -n --arg in "$blocker" --arg out "$blocked" \
      '{type:{name:"Blocks"}, inwardIssue:{key:$in}, outwardIssue:{key:$out}}')
    json POST 'api/2/issueLink' -d "$payload" >/dev/null || exit 1
    back=$(links_of "$blocked") || exit 1
    if ! printf '%s' "$back" | jq -e --arg o "$blocker" 'any(.[]; .rel == "blocked-by" and .key == $o)' >/dev/null; then
      echo "desk-jira: the link was posted but the read-back of $blocked does not show 'is blocked by $blocker'." >&2
      echo "  $blocked's Blocks links now: $(printf '%s' "$back" | jq -r 'map("\(.rel) \(.key)") | join(", ") | if . == "" then "none" else . end')" >&2
      echo "  A link that landed backwards is deleted with DELETE /rest/api/3/issueLink/<id> (references/jira-rest-recipes.md), then re-run this." >&2
      exit 1
    fi
    echo "linked: $blocked is blocked by $blocker (read back)"
    ;;

  fields)
    res=$(api GET 'api/3/field')
    if [[ -n "${1:-}" ]]; then
      printf '%s' "$res" | jq -r --arg f "$1" \
        '.[] | select(.name | ascii_downcase | contains($f | ascii_downcase)) | "\(.id)\t\(.name)\t\(.schema.type // "-")"'
    else
      printf '%s' "$res" | jq -r '.[] | select(.custom) | "\(.id)\t\(.name)\t\(.schema.type // "-")"'
    fi
    ;;

  meta)
    [[ -n "$PROJECT" ]] || die "no Jira project for $SLUG: set §4 Jira project in $REPO_DIR/config.md, or JIRA_PROJECT"
    res=$(api GET "api/2/issue/createmeta?projectKeys=$PROJECT&expand=projects.issuetypes.fields")
    printf '%s' "$res" | jq -r --arg t "${1:-}" '
      .projects[0].issuetypes[]
      | select($t == "" or (.name | ascii_downcase) == ($t | ascii_downcase))
      | "== \(.name)",
        (.fields | to_entries[] | select(.value.required)
          | "  required: \(.key)  (\(.value.name))"),
        (.fields | to_entries[] | select(.value.allowedValues != null)
          | "  \(.key) (\(.value.name)) allows: \([.value.allowedValues[] | .name // .value] | join(", "))")'
    ;;

  create)
    [[ -n "$PROJECT" ]] || die "no Jira project for $SLUG: set §4 Jira project in $REPO_DIR/config.md, or JIRA_PROJECT"
    [[ $# -ge 3 ]] || die 'usage: desk-jira create <type> <summary> <desc-file|text> [field=value ...] [--route]'
    type="$1"; summary="$2"; desc=$(text_of "$3" && printf x) || exit 2; desc="${desc%x}"; shift 3
    errs=$(desc_errors "$desc") || die "desk-jira: could not check the description"
    [[ -z "$errs" ]] || die "$errs"
    split_approved "$@"
    route=0; pairs=()
    for a in ${REST[@]+"${REST[@]}"}; do if [[ "$a" == --route ]]; then route=1; else pairs+=("$a"); fi; done
    extra=$(fields_from_args ${pairs[@]+"${pairs[@]}"}) || exit 2
    # An issuetype among the fields replaces <type> in the payload, so the rules read that one.
    # Only {"name"}: Jira resolves an id before a name, so an id would bypass the type read here.
    type=$(printf '%s' "$extra" | jq -r --arg t "$type" 'if has("issuetype") then
      (.issuetype | if type == "object" and keys == ["name"] and (.name | type) == "string" then .name else empty end) else $t end')
    [[ -n "$type" ]] || die "desk-jira: pass issuetype by its name, so the field rules know the type"
    errs=$(rule_errors create "$type" "$extra" "$APPROVED") || die "desk-jira: could not check the field rules"
    [[ -z "$errs" ]] || die "$errs"
    # An assignee other than you is routing (§3 jira-route), and needs --route spelt out so a harness
    # rule can prompt on it while assignee=me goes through. With §3 jira-assign-self yes and no
    # assignee given, the new ticket is yours: autopilot only picks up tickets assigned to you.
    want=$(printf '%s' "$extra" | jq -r 'if has("assignee") | not then ""
      elif .assignee == null then "none"
      elif (.assignee | type) == "object" and (.assignee | has("accountId")) then .assignee.accountId | tostring
      else .assignee | tojson end')
    if [[ -z "$want" && "$(cfg_perm jira-assign-self)" == yes ]] || [[ -n "$want" && "$want" != none ]]; then
      me=$(my_account_id)
      [[ -n "$me" && "$me" != null ]] || die "desk-jira: could not read your accountId to set the assignee"
      if [[ -z "$want" ]]; then
        extra=$(printf '%s' "$extra" | jq --arg me "$me" '.assignee={accountId:$me}')
      elif [[ "$want" != "$me" ]] && (( ! route )); then
        die "desk-jira: assignee $want is not you, which routes the ticket to someone else: add --route if that is meant (§3 jira-route)"
      fi
    fi
    payload=$(jq -n \
      --arg p "$PROJECT" --arg t "$type" --arg s "$summary" --arg d "$desc" --argjson e "$extra" \
      '{fields: ({project:{key:$p}, issuetype:{name:$t}, summary:$s, description:$d} + $e)}')
    key=$(json POST 'api/2/issue' -d "$payload" | jq -r '.key')
    echo "created $key  https://$SITE/browse/$key"
    # A 201 is not proof the assignee landed (a project can drop it), so read it back.
    if back=$(api GET "api/2/issue/$key?fields=assignee"); then
      printf '%s' "$back" | jq -r --argjson sent "$extra" "$JQ_VAL"'
        if .fields.assignee == null and ($sent.assignee // null) != null then "  assignee: (empty - the assignment did not stick)"
        else "  assignee: \(.fields.assignee | val)" end'
    else
      echo "  assignee: (could not read back)"
    fi
    if [[ -n "$APPROVED" ]]; then record_approval "$key" "$extra" "$APPROVED"; fi
    ;;

  edit)
    [[ $# -ge 2 ]] || die 'usage: desk-jira edit <KEY> <field=value ...> [--approved <text>]'
    key="$1"; shift
    [[ "$key" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]] || die "desk-jira: not an issue key: $key"
    split_approved "$@"
    [[ ${#REST[@]} -ge 1 ]] || die 'usage: desk-jira edit <KEY> <field=value ...> [--approved <text>]'
    f=$(fields_from_args "${REST[@]}") || exit 2
    # The rules depend on the issue type, so read it unless the edit sets it (by name) itself.
    type=$(printf '%s' "$f" | jq -r 'if has("issuetype") then
      (.issuetype | if type == "object" and keys == ["name"] and (.name | type) == "string" and .name != "" then .name else "?" end) else empty end')
    [[ "$type" != '?' ]] || die "desk-jira: pass issuetype by its name, so the field rules know the type"
    load_rules
    if [[ -z "$type" && ( "$RULES_REQ" != '[]' || -n "$RULES_SIZE" ) ]]; then
      type=$(api GET "api/2/issue/$key?fields=issuetype" | jq -r '.fields.issuetype.name // empty') || true
      [[ -n "$type" ]] || die "desk-jira: could not read the issue type of $key, so its field rules cannot be checked"
    fi
    errs=$(rule_errors edit "${type:--}" "$f" "$APPROVED") || die "desk-jira: could not check the field rules"
    [[ -z "$errs" ]] || die "$errs"
    if printf '%s' "$f" | jq -e '.description | type == "string"' >/dev/null; then
      errs=$(desc_errors "$(printf '%s' "$f" | jq -r '.description')") || die "desk-jira: could not check the description"
      [[ -z "$errs" ]] || die "$errs"
    fi
    payload=$(jq -n --argjson f "$f" '{fields:$f}')
    json PUT "api/2/issue/$key" -d "$payload" >/dev/null
    # A 204 is not proof the value landed (a bare accountId can no-op), so read it back.
    names=$(printf '%s' "$f" | jq -r 'keys | join(",")')
    back=$(api GET "api/2/issue/$key?fields=$names")
    echo "updated $key - read back:"
    printf '%s' "$back" | jq -r --argjson sent "$f" "$JQ_VAL"'
      .fields as $got | $sent | keys[] as $k
      | ($got[$k]) as $v
      | if $v == null and $sent[$k] != null then "  \($k): (empty - the write did not stick)"
        else "  \($k): " + ($v | val | gsub("\n"; " ") | if length > 120 then .[0:120] + "..." else . end)
        end'
    # A parent that does not stick files the issue under the wrong epic or none, so it fails.
    want=$(printf '%s' "$f" | jq -r '.parent.key // empty')
    if [[ -n "$want" ]]; then
      got=$(printf '%s' "$back" | jq -r '.fields.parent.key // empty')
      [[ "$got" == "$want" ]] || die "desk-jira: the parent of $key reads back as ${got:--}, not $want: the parent did not stick"
    fi
    if [[ -n "$APPROVED" ]]; then record_approval "$key" "$f" "$APPROVED"; fi
    ;;

  labels)
    [[ $# -ge 2 ]] || die 'usage: desk-jira labels <KEY> add|remove <label ...>'
    key="$1"; op="$2"; shift 2
    [[ "$op" == add || "$op" == remove ]] || die 'op must be add or remove'
    ops=$(printf '%s\n' "$@" | jq -R . | jq -s --arg op "$op" '[.[] | {($op): .}]')
    payload=$(jq -n --argjson ops "$ops" '{update:{labels:$ops}}')
    json PUT "api/2/issue/$key" -d "$payload" >/dev/null && echo "$op labels on $key: $*"
    ;;

  comment)
    [[ $# -ge 2 ]] || die 'usage: desk-jira comment <KEY> <body-file|text>'
    key="$1"; body=$(text_of "$2" && printf x) || exit 2; body="${body%x}"
    payload=$(jq -n --arg b "$body" '{body:$b}')
    json POST "api/2/issue/$key/comment" -d "$payload" \
      | jq -r '"commented on '"$key"' (id \(.id))"'
    ;;

  comments)
    [[ $# -ge 1 ]] || die 'usage: desk-jira comments <KEY>'
    ensure_auth
    api GET "api/2/issue/$1/comment" \
      | jq -r 'if (.comments|length)==0 then "no comments" else
          .comments[] | "--- \(.author.displayName) \(.created[0:10]) (id \(.id))\n\(.body)" end'
    ;;

  transitions)
    [[ $# -ge 1 ]] || die 'usage: desk-jira transitions <KEY>'
    api GET "api/2/issue/$1/transitions" \
      | jq -r '.transitions[] | "\(.id)\t\(.name)\t-> \(.to.name)"'
    ;;

  transition)
    [[ $# -ge 2 ]] || die 'usage: desk-jira transition <KEY> <name-or-id>'
    key="$1"; want="$2"
    list=$(api GET "api/2/issue/$key/transitions")
    id=$(printf '%s' "$list" | jq -r --arg w "$want" '
      [.transitions[] | select((.id == $w) or (.name | ascii_downcase) == ($w | ascii_downcase))]
      | if length == 1 then .[0].id else empty end')
    if [[ -z "$id" ]]; then
      echo "no unique match for '$want'. available:" >&2
      printf '%s' "$list" | jq -r '.transitions[] | "  \(.id)\t\(.name)\t-> \(.to.name)"' >&2
      exit 1
    fi
    payload=$(jq -n --arg id "$id" '{transition:{id:$id}}')
    json POST "api/2/issue/$key/transitions" -d "$payload" >/dev/null
    echo "$key -> $(printf '%s' "$list" | jq -r --arg id "$id" '.transitions[]|select(.id==$id)|.to.name')"
    ;;

  attach)
    [[ $# -ge 2 ]] || die 'usage: desk-jira attach <KEY> <file ...>'
    key="$1"; shift
    args=()
    for f in "$@"; do [[ -f "$f" ]] || die "no such file: $f"; check_outgoing_file "$f"; args+=(-F "file=@$f"); done
    api POST "api/3/issue/$key/attachments" -H 'X-Atlassian-Token: no-check' "${args[@]}" \
      | jq -r '.[] | "attached \(.filename) (\(.size) bytes)"'
    ;;

  api)
    [[ $# -eq 1 ]] || die 'usage: desk-jira api <path>   (GET only; the path is everything after /rest/)'
    api GET "$1"; echo
    ;;

  md2wiki)
    # Read-only preview: nothing is sent, so the file may live anywhere.
    [[ $# -eq 1 ]] || die 'usage: desk-jira md2wiki <file|->   (prints the body create, comment and edit would send)'
    if [[ "$1" == - ]]; then md_to_wiki
    elif [[ -f "$1" ]]; then
      case "$1" in *.md) md_to_wiki < "$1" ;; *) cat "$1" ;; esac
    else die "desk-jira: file not found: $1"; fi
    ;;

  -h|--help|help) usage ;;
  *) die "unknown command: $cmd (try --help)" ;;
esac
